  payoutAccount        TutorPayoutAccount? @relation("PayoutAccountUser")
  invoicesIssued       TuitionInvoice[]    @relation("InvoiceTutor")
  invoicesReceived     TuitionInvoice[]    @relation("InvoiceStudent")
  bankTransactions     BankTransaction[]   @relation("BankTxTutor")
  tuitionCredits       TuitionCredit[]     @relation("CreditTutor")
  tuitionCreditsOwned  TuitionCredit[]     @relation("CreditStudent")
