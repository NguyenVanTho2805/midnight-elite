generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── COURSES ──────────────────────────────────────────────────────────────────

model Course {
  id            String   @id // slug: "hsa-tron-goi"
  adminId       Int      @unique
  sortOrder     Int      @unique @default(autoincrement()) // thứ tự hiển thị trên trang công khai (theo thứ tự tạo)
  name          String // tên công khai
  adminName     String // tên nội bộ
  // PH-215/216: link nhóm Zalo của lớp (https://zalo.me/g/…) — "cổng phụ huynh" không bắt tải app. Tin vào nhóm chỉ là tin chung.
  zaloGroupUrl  String?
  shortTitle    String
  category      String
  instructor    String
  teacherAvatar String
  openDate      String
  types         String[]
  tag           String?
  tagColor      String?
  bg            String
  strip         String   @default("#FDE047")
  introVideo    String?
  zaloGroupLink String?
  price         Int
  originalPrice Int?
  lessons       Int      @default(0)
  hours         Int      @default(0)
  status        Boolean  @default(true)
  createdAt     String

  // Sức chứa tối đa của lớp — null = không giới hạn. Áp dụng khi tạo
  // Enrollment mới (ClassInvite.redeem + mua Subscription), không ảnh hưởng
  // Enrollment đã có.
  capacity Int?

  // Trạng thái vận hành của lớp (không trùng `status` ở trên — `status` là cờ
  // ẩn/hiện công khai dạng Boolean, giữ nguyên vì có nhiều route đang đọc).
  //   - "open"   : đang nhận thêm học viên (mặc định)
  //   - "closed" : đã đóng, không nhận thêm — Enrollment cũ vẫn hoạt động
  //   - "paused" : tạm ngừng cả hoạt động mới lẫn hiện có
  classStatus String @default("open")

  // Giáo viên sở hữu (null = nội dung cũ/của quản lý trung tâm). Chỉ dùng để
  // scope quyền khi User.adminRole === "teacher" — admin_super/admin_content
  // luôn thấy & sửa được mọi Course bất kể ownerId.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  sections         Section[]
  enrollments      Enrollment[]
  cartItems        CartItem[]
  reviews          CourseReview[]
  exams            Exam[]
  classSchedules   ClassSchedule[]
  classAbsences    ClassAbsence[]
  makeupCredits    MakeupCredit[]
  sessionChanges   ClassSessionChange[]
  reminderLogs     ClassReminderLog[]
  coinTransactions CoinTransaction[]
  threads          Thread[]
  classInvites       ClassInvite[]
  monthlyFees        MonthlyCourseFee[]
  attendanceSessions AttendanceSession[]
  feeRates           CourseFeeRate[]
  studentFeeRates    CourseStudentRate[]
  feeCharges         FeeCharge[]
  sessionPackages    SessionPackage[] // HP-31 gói buổi trả trước (bảng mới)

  // HP-15 (23/10/2026): cách tính học phí của lớp, CHỌN LÚC TẠO LỚP và chỉ lớp tạo sau mới khác mặc định.
  //   "monthly_sessions" (mặc định, MỌI lớp cũ) : gia sư nhập số buổi tháng (MonthlyCourseFee) — cách tính hiện tại, KHÔNG đổi.
  //   "per_session" | "per_hour" | "per_course" : học phí sinh ra từ buổi ĐÃ CHỐT (FeeCharge; chủ chốt 24/10/2026), đơn giá ở CourseFeeRate.
  feeMode String @default("monthly_sessions")
  // BUỔI/LỊCH (LI-02, LI-17): màu lớp trên Lịch (khoá trong src/lib/classColor.ts, KHÔNG phải mã hex; null = suy từ mã lớp như cũ)
  // và link học online CHUNG của lớp (ưu tiên thấp nhất: riêng buổi > theo khung giờ > chung lớp).
  calendarColor String?
  classJoinUrl  String?
  studentProfiles    StudentProfile[]

  @@index([ownerId])
  @@map("courses")
}

// Khung giờ học cố định lặp lại hàng tuần của 1 khoá (kiểu TKB) — KHÔNG phải
// 1 dòng cho từng buổi cụ thể, mà là 1 quy luật lặp (vd "Thứ 2 & Thứ 5,
// 19h-21h"). /api/schedule tự tính ra buổi học sắp tới từ quy luật này cho
// từng học viên theo khoá đã đăng ký, giống cách nó đang tự tính lịch thi từ
// Exam.date — không cần tạo bản ghi riêng cho từng tuần.
model ClassSchedule {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=CN, 1=T2 ... 6=T7 (khớp Date.getDay() của JS)
  startTime String // "19:00"
  endTime   String // "21:00"
  note      String? // vd "Học live qua Zoom" — hiện kèm trong lịch/email nhắc
  joinUrl   String? // link vào lớp (Meet/Zoom) — in vào tin nhắc lịch (TT-201); trống thì tin bỏ dòng này
  // LI-16: hình thức của khung giờ ("online" | "offline"; null = chưa chọn, hiểu như cũ) và địa chỉ khi học offline.
  mode      String?
  location  String?
  active    Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([courseId])
  @@map("class_schedules")
}

// "Theo dõi lớp" (BE-079, chốt 06/10/2026). Trước đây là giỏ hàng; theo D01
// học viên học miễn phí nên bỏ khái niệm giỏ hàng, chỉ còn danh sách lớp học
// viên quan tâm. Giữ tên model/bảng cart_items để `db push` khi build không
// xoá dữ liệu các lớp người dùng đã lưu.
model CartItem {
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@map("cart_items")
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int // 1–5
  comment   String   @db.Text
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("course_reviews")
}

// ─── CURRICULUM ───────────────────────────────────────────────────────────────

model Section {
  id       String    @id
  title    String
  order    Int       @default(0)
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@map("sections")
}

model Chapter {
  id        String   @id
  title     String
  order     Int      @default(0)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@map("chapters")
}

model Lesson {
  id             String           @id
  code           String
  title          String
  type           String // "record" | "live" | "quiz" | "document"
  duration       String?
  videoUrl       String?
  zoomUrl        String?
  azotaUrl       String?
  azotaDeadline  String?
  documents      String?          @default("[]")
  adminNote      String?
  isLocked       Boolean          @default(true)
  isFree         Boolean          @default(false)
  statsVideos    Int              @default(0)
  statsMaterials Int              @default(0)
  statsViews     Int              @default(0)
  order          Int              @default(0)
  chapterId      String
  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress       LessonProgress[]
  notes          LessonNote[]
  azotaDone      LessonAzotaDone[]
  assignments    Assignment[]

  @@map("lessons")
}

// Bài tập tự nộp trên nền tảng — song song với Lesson.azotaUrl (link Azota
// ngoài), KHÔNG thay thế. 1 Lesson có thể có nhiều Assignment (giống
// azotaUrls cho phép nhiều link/lesson). Điểm bài tập là chỉ số RIÊNG, không
// gộp vào công thức GPA (xem computeAssignmentAverage trong src/lib/gpa.ts).
model Assignment {
  id           String    @id @default(cuid())
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  instructions String?   @db.Text
  fileUrl      String? // đề bài giáo viên cung cấp — học viên tải về làm, null = chỉ có hướng dẫn text
  fileName     String?
  maxPoints    Float     @default(10)
  dueDate      DateTime?

  // "file" (nộp file, mặc định — hành vi cũ giữ nguyên) | "interactive"
  // (làm trực tiếp trên web, câu hỏi AI trích từ file — xem
  // AssignmentQuestion). dueDate BẮT BUỘC khi mode="interactive" (ép ở tầng
  // API, không ép được ở DB vì "file" vẫn cho phép để trống) — dueDate vừa
  // là mốc khoá bài vừa là mốc tự hiện đáp án đúng/sai cho học viên, so
  // sánh ĐỘNG mỗi lần gọi (không snapshot) nên sửa lại dueDate muộn hơn sẽ
  // tự mở khoá lại, sớm hơn thì tự khoá lại ngay.
  mode String @default("file")

  // Xem ghi chú ở Course.ownerId — cùng quy tắc scope quyền (chỉ chủ sở
  // hữu/admin_content/admin_super sửa/xoá/chấm).
  ownerId String?
  owner   User?   @relation("OwnedAssignments", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions AssignmentSubmission[]
  questions   AssignmentQuestion[]

  @@index([lessonId])
  @@map("assignments")
}

// Bài học viên nộp cho 1 Assignment — @@unique([assignmentId, userId]) nghĩa
// là nộp lại sẽ GHI ĐÈ bản cũ (không tích luỹ nhiều lần nộp). Nộp lại một bài
// đã chấm sẽ xoá score/gradedAt/comment cũ (bắt chấm lại), tránh điểm cũ gắn
// nhầm với nội dung đã sửa — xem submit/route.ts.
model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("AssignmentSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String?
  // "file" (tệp tải lên, mặc định: hành vi cũ) | "link" (học sinh dán LINK bài làm Azota; fileUrl giữ link đó) | "done" (chỉ bấm "Em đã làm xong", fileUrl rỗng).
  // KHÔNG có loại ảnh: KiN không nhận ảnh bài làm của học sinh dưới 16 tuổi (xem src/lib/mediaLink.ts validateWorkLink).
  kind         String     @default("file")
  submittedAt  DateTime   @default(now())

  // null = chưa chấm. Cả 2 field dưới null nếu chưa chấm.
  score    Float?
  comment  String?   @db.Text
  gradedAt DateTime?
  gradedBy String? // userId giáo viên đã chấm gần nhất

  @@unique([assignmentId, userId])
  @@map("assignment_submissions")
}

// Câu hỏi của bài tập kiểu "interactive" — AI trích từ file giáo viên tải
// lên (dùng chung extractQuestionsFromFiles với Thi thử), nhưng lưu RIÊNG,
// không đụng vào Ngân hàng câu hỏi. Chỉ 2 loại cho bản đầu: MC/ESSAY.
model AssignmentQuestion {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  order        Int
  text         String     @db.Text
  imageUrl     String?
  points       Float      @default(1)
  type         String     @default("MC") // "MC" | "ESSAY"
  explanation  String?    @db.Text

  options AssignmentOption[]
  answers AssignmentAnswer[]

  @@index([assignmentId])
  @@map("assignment_questions")
}

model AssignmentOption {
  id         String             @id @default(cuid())
  questionId String
  question   AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  isCorrect  Boolean            @default(false)

  answers AssignmentAnswer[]

  @@index([questionId])
  @@map("assignment_options")
}

// 1 dòng / học viên / câu hỏi — upsert theo (userId, questionId) mỗi lần
// trả lời (autosave, không có nút "Nộp bài"). isCorrect tính ngầm ngay lúc
// lưu với câu MC (so optionId với AssignmentOption.isCorrect), nhưng API
// đọc bài làm PHẢI ẩn field này với chính học viên đó cho tới khi qua
// Assignment.dueDate — chỉ ẩn ở tầng API, không ẩn được ở DB.
model AssignmentAnswer {
  id         String             @id @default(cuid())
  questionId String
  question   AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation("AssignmentAnswers", fields: [userId], references: [id], onDelete: Cascade)

  optionId String?
  option   AssignmentOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  textAnswer String? @db.Text // câu ESSAY

  isCorrect Boolean? // MC: tự chấm ngay. ESSAY: luôn null, không dùng field này để chấm.

  // ESSAY: giáo viên chấm tay — null nghĩa là chưa chấm.
  pointsAwarded  Float?
  teacherComment String? @db.Text

  updatedAt DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([questionId])
  @@map("assignment_answers")
}

// ─── EXAMS ────────────────────────────────────────────────────────────────────

model Exam {
  id           String  @id
  code         String  @unique
  title        String
  category     String
  date         String
  time         String
  duration     String
  questions    Int
  status       String // "upcoming" | "available" | "completed"
  azotaUrl     String? @default("")
  participants Int     @default(0)
  active       Boolean @default(true)
  activeGuest  Boolean @default(true)
  guestCanTake Boolean @default(false)
  createdAt    String

  // Xem ghi chú ở Course.ownerId — cùng quy tắc scope quyền.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Đề thi có thể gắn với 1 khoá học cụ thể (null = đề thi chung, không thuộc
  // khoá nào). Dùng để quyết định ai được thi miễn phí khi có price: học viên
  // đã Enrollment vào courseId này thì miễn phí, còn lại phải có ExamGuestAccess.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // null/0 = miễn phí cho tất cả (theo activeGuest/guestCanTake như cũ).
  // Có giá trị = học viên đã đăng ký courseId ở trên thi miễn phí, người khác
  // (guest hoặc học viên khoá khác) cần được duyệt qua ExamGuestAccess.
  price Int?

  // Thang % điểm câu Đúng-Sai 4 ý theo số ý trả lời đúng — mảng 4 số [1 ý,
  // 2 ý, 3 ý, 4 ý đúng] tính theo %, vd [10,25,50,100]. null = dùng mặc định
  // (xem CLUSTER_PERCENT_BY_CORRECT_COUNT trong src/lib/examGrading.ts).
  clusterScorePercents Json?

  // Tổng điểm hiển thị cuối cùng cho học viên (thang quy đổi, KHÁC với tổng
  // điểm thô = sum(ExamQuestion.points)) — điểm thô luôn được rescale về
  // đúng thang này khi chấm (xem finalizeAttempt/regradeAttempt trong
  // src/lib/examGrading.ts). Mặc định 150 để khớp hành vi hardcode trước đây.
  totalPoints Float @default(150)

  // null = không yêu cầu mật khẩu. Có giá trị = học viên phải nhập đúng mật
  // khẩu này mới bắt đầu làm bài được (đọc tại chỗ trong phòng thi có giám
  // sát, giống Azota) — KHÔNG BAO GIỜ trả field này qua API GET, chỉ trả
  // `hasPassword: boolean` (xem exams/route.ts, exams/[id]/route.ts).
  password String?

  // QZ-14: mật khẩu vào thi ở dạng BĂM (bcrypt của sha256, xem src/lib/examPassword.ts). Đề mới/đặt lại chỉ ghi cột này và để `password` null.
  // Đề cũ còn `password` thô vẫn dùng được (đọc tương thích) và tự nâng lên băm. Không bao giờ trả qua API.
  passwordHash String?

  // true = học viên xem được bảng xếp hạng Top 10 của đề này; false = ẩn
  // hoàn toàn (giáo viên không muốn học viên so điểm công khai).
  showLeaderboard Boolean @default(true)

  // Khi nào học viên xem được màn "Xem lại bài làm" (đáp án đúng/giải thích):
  // "never" | "after_submit" (ngay sau khi nộp) | "after_exam_ends" (chỉ sau
  // khi hết thời hạn làm bài của đề — tính từ date+time+duration, xem
  // hasExamWindowEnded() trong src/lib/examGrading.ts).
  answerVisibility String @default("after_submit")

  // true = câu học sinh trả lời SAI chỉ hiện "Sai", không lộ đáp án đúng thật
  // (chặn kiểu nộp bừa để dò đáp án rồi thi lại) — áp dụng khi answerVisibility
  // đã cho phép xem đáp án. Câu trả lời ĐÚNG vẫn luôn hiện đáp án bình thường.
  hideAnswerForWrong Boolean @default(false)

  // QZ-04 / QZ-07 (gia sư soạn quiz, phiên bản). Toàn bộ cột THÊM, nullable hoặc có mặc định — đề cũ không đổi gì.
  //   isDraft        — bản nháp chưa phát hành: học sinh không thấy, không vào thi được (route start chặn). Mặc định false = đề cũ vẫn như cũ.
  //   rootExamId     — id của phiên bản đầu tiên trong chuỗi phiên bản (null = đề này là gốc, hoặc đề cũ chưa từng có phiên bản).
  //   versionNo      — số phiên bản trong chuỗi (1 = bản đầu).
  //   supersededById — phiên bản mới đã THAY bản này (null = bản đang dùng). Bản bị thay vẫn giữ nguyên câu hỏi/đáp án/bài làm/điểm.
  //   supersededAt   — lúc bản mới được phát hành.
  //   versionNote    — lý do tạo phiên bản (gia sư ghi).
  isDraft        Boolean   @default(false)
  rootExamId     String?
  versionNo      Int       @default(1)
  supersededById String?
  supersededAt   DateTime?
  versionNote    String?   @db.Text

  results       ExamResult[]
  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]
  guestAccess   ExamGuestAccess[]

  @@index([ownerId])
  @@index([courseId])
  @@index([rootExamId])
  @@map("exams")
}

// Ngân hàng câu hỏi dùng chung giữa các giáo viên — kho bản mẫu ĐỘC LẬP với
// ExamQuestion, KHÔNG share row trực tiếp: ExamAnswer trỏ thẳng vào row sống
// của câu hỏi/đáp án trong đề (không phải snapshot đóng băng), nên sửa/xoá 1
// câu dùng chung sẽ phá lịch sử chấm điểm của học viên đã thi. Khi thêm 1 câu
// từ ngân hàng vào đề (tính năng sau), hệ thống COPY nội dung thành
// ExamQuestion mới — ngân hàng và đề sau đó hoàn toàn độc lập.
model QuestionBankItem {
  id          String   @id @default(cuid())
  type        String   @default("MC") // "MC" | "ESSAY" | "TRUE_FALSE_CLUSTER" | "SHORT_ANSWER" — giống ExamQuestion.type
  text        String   @db.Text
  imageUrl    String?
  points      Float    @default(1)
  explanation String?  @db.Text
  hint        String?  @db.Text // NV-188 — gợi ý cho màn Chữa bài, copy sang ExamQuestion.hint khi rút vào đề

  // Đầu mục phân cấp (thay subject/topic phẳng cũ) — lá của cây
  // QuestionCategory, dùng để thu hẹp phạm vi so trùng khi phát hiện trùng
  // lặp, và để lọc/tìm trong danh sách. Bắt buộc chọn 1 đầu mục cụ thể (có
  // thể ở bất kỳ tầng nào của cây).
  categoryId String
  category   QuestionCategory @relation(fields: [categoryId], references: [id])
  difficulty String // "NB" | "TH" | "VD" | "VDC" (nhận biết/thông hiểu/vận dụng/vận dụng cao)
  tags       Json? // string[] tự do, tùy chọn

  // Hash nội dung đã chuẩn hoá (xem computeContentHash trong
  // src/lib/questionDedup.ts) — tra trùng Y HỆT trong phạm vi categoryId
  // (Giai đoạn 3.5 Cấp 1). null = chưa từng tính (bản ghi cũ trước tính năng
  // này, được tính lại khi sửa).
  contentHash String?

  // Giai đoạn 3.5 Cấp 3 — vector embedding (Gemini gemini-embedding-001, 768
  // chiều) để tra trùng GIỐNG NGHĨA (semantic), khác Cấp 1 (y hệt/hash) và
  // Cấp 2 (giống chuỗi/pg_trgm). `Unsupported` vì Prisma Client không thao
  // tác trực tiếp kiểu `vector` — mọi đọc/ghi cột này đều qua $queryRaw/
  // $executeRaw trong src/lib/embeddings.ts. null = chưa từng tính (bản ghi
  // cũ trước tính năng này, hoặc lần gọi Gemini gần nhất lỗi — không chặn
  // lưu câu hỏi nếu tính embedding thất bại, chỉ đơn giản bỏ qua câu đó khi
  // so Cấp 3 lần sau, được tính lại khi sửa).
  embedding Unsupported("vector(768)")?

  // Giai đoạn 6 — quy trình duyệt. "draft" (đang soạn, chỉ chủ sở hữu +
  // admin_content/admin_super thấy) | "pending" (đã gửi duyệt, chờ admin
  // xét) | "approved" (đã duyệt, vào kho dùng chung — CHỈ trạng thái này mới
  // được rút vào đề qua QuestionBankPicker/AutoDrawModal). Mặc định
  // "approved" để KHÔNG đổi hành vi của mọi bản ghi đã có trước Giai đoạn 6
  // (route tạo/sửa mới sẽ tự set giá trị tường minh, default chỉ áp cho dữ
  // liệu cũ). admin_content/admin_super tạo/sửa → luôn "approved" ngay
  // (không cần tự duyệt bài của mình); "teacher" tạo → "draft", phải chủ
  // động gửi duyệt (PATCH .../submit) mới thành "pending".
  status String @default("approved")

  // Lý do admin từ chối lần gần nhất — chỉ có ý nghĩa khi status="draft" sau
  // khi bị từ chối (khác "draft" do chưa từng gửi, lúc đó null). Xoá khi gửi
  // duyệt lại.
  rejectionReason String? @db.Text
  reviewedBy      String? // userId admin đã duyệt/từ chối gần nhất
  reviewedAt      DateTime?

  // Người soạn — dùng chung giữa mọi giáo viên (ai cũng xem/lọc được tất cả),
  // nhưng chỉ chủ sở hữu (hoặc admin_super/admin_content) mới sửa/xoá được,
  // xem ownsResource()/requireOwnedResource() trong src/lib/auth-guard.ts.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options       QuestionBankOption[]
  examQuestions ExamQuestion[]

  @@index([categoryId])
  @@index([categoryId, contentHash])
  @@index([status])
  @@map("question_bank_items")
}

// Cây đầu mục phân cấp không giới hạn số tầng (vd Môn → Chương → Bài →
// Dạng bài) — thay cho subject/topic phẳng cũ của QuestionBankItem. Dùng
// chung giữa mọi giáo viên (ai cũng xem/chọn được, sửa/xoá qua trang quản lý
// riêng — không có khái niệm chủ sở hữu, khác Course/Exam/QuestionBankItem).
// KHÔNG đặt onDelete: Cascade ở quan hệ cha-con hay ở QuestionBankItem.category
// — API xoá phải tự chặn khi còn con hoặc còn câu hỏi gắn vào, tránh xoá
// nhầm cả nhánh cây (xem src/app/api/question-categories/[id]/route.ts).
model QuestionCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    QuestionCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  QuestionCategory[] @relation("CategoryTree")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  bankItems QuestionBankItem[]

  @@index([parentId])
  @@map("question_categories")
}

model QuestionBankOption {
  id        String  @id @default(cuid())
  itemId    String
  order     Int     @default(0)
  text      String  @db.Text
  isCorrect Boolean @default(false)
  subLabel  String? // chỉ dùng cho TRUE_FALSE_CLUSTER: "a"|"b"|"c"|"d"

  item QuestionBankItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("question_bank_options")
}

// Câu hỏi thi trắc nghiệm trong platform — KHÔNG liên quan đến model
// Question/Answer bên dưới (đó là module Hỏi Đáp cộng đồng, khác hoàn toàn).
model ExamQuestion {
  id          String   @id
  examId      String
  order       Int      @default(0)
  text        String   @db.Text
  imageUrl    String?
  points      Float    @default(1)
  explanation String?  @db.Text
  // NV-188: gợi ý do gia sư viết khi soạn câu hỏi. Chỉ hiện ở màn Chữa bài sau lần nộp đầu SAI, và không
  // bao giờ gửi cho học viên lúc đang làm bài. Trống = bỏ bước gợi ý (hiện đáp án sau lần nộp đầu).
  hint        String?  @db.Text
  createdAt   DateTime @default(now())

  // "MC" (trắc nghiệm 1 đáp án, mặc định) | "MC_MULTI" (nhiều đáp án đúng, QZ-03: chấm đủ-hoặc-không, câu trả lời lưu ở ExamAnswerBoolean
  // — mỗi ô học sinh tích là một dòng answerTrue=true) | "ESSAY" (tự luận, chấm tay) |
  // "TRUE_FALSE_CLUSTER" (1 đoạn dẫn + 4 mệnh đề con, mỗi ý tự đúng/sai độc
  // lập — không phải chọn 1 trong 4, xem ExamOption.subLabel/ExamAnswerBoolean) |
  // "SHORT_ANSWER" (điền đáp án ngắn, chấm tự động so khớp text — đáp án đúng
  // lưu trong ExamOption duy nhất của câu, xem examGrading.ts).
  type String @default("MC")

  // Tên Phần thi (vd "Phần Trắc nghiệm") để nhóm hiển thị — null = không
  // thuộc phần nào (đề cũ, hoặc đề không cần chia phần). Chỉ dùng để nhóm
  // hiển thị + xáo trong phạm vi từng phần (shuffleQuestionOrderBySections
  // trong examGrading.ts), không ảnh hưởng tới cách tính điểm.
  sectionLabel String?

  // Số phút riêng cho Phần này (vd đề ĐGNL HSA: mỗi Phần có giờ riêng, hết
  // giờ Phần nào khoá Phần đó). Lặp lại giống nhau ở mọi câu cùng
  // sectionLabel — admin tự nhập đồng bộ. null = không dùng giờ riêng Phần
  // (xem computeSectionWindows trong examGrading.ts để biết điều kiện bật).
  sectionMinutes Int?

  // Truy vết câu này được copy từ đâu trong Ngân hàng câu hỏi (null = soạn
  // tay/AI trích xuất, không từ ngân hàng). CHỈ để tham khảo nguồn gốc — nội
  // dung đã copy độc lập hoàn toàn, sửa/xoá câu gốc trong ngân hàng KHÔNG
  // ảnh hưởng câu này (onDelete: SetNull, không Cascade — xem ghi chú ở
  // QuestionBankItem về nguyên tắc không share row).
  sourceBankItemId String?
  sourceBankItem   QuestionBankItem? @relation(fields: [sourceBankItemId], references: [id], onDelete: SetNull)

  // QZ-03 — thêm cho câu tự luận (cột nullable, câu cũ để trống):
  //   studentGuide — "Hướng dẫn cho học sinh" (học sinh thấy lúc làm bài).
  //   graderGuide  — "Hướng dẫn chấm": CHỈ gia sư thấy, không bao giờ gửi cho học sinh (kiểm ở applyAttemptOrder + route review).
  //   rubric       — tiêu chí chấm [{ name, requirement, points }]; tổng điểm các tiêu chí phải bằng `points` của câu (kiểm ở src/lib/quizQuestion.ts).
  studentGuide String? @db.Text
  graderGuide  String? @db.Text
  rubric       Json?

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  options ExamOption[]
  answers ExamAnswer[]
  corrections ExamCorrection[]

  @@index([examId, order])
  @@map("exam_questions")
}

model ExamOption {
  id         String  @id
  questionId String
  order      Int     @default(0) // vị trí A/B/C/D suy ra từ order, không lưu chữ cái
  text       String  @db.Text
  // MC: đây có phải đáp án đúng không. TRUE_FALSE_CLUSTER: mệnh đề này có
  // đúng không (giá trị đúng/sai thật của phát biểu, không phải câu trả lời
  // của học sinh — câu trả lời của học sinh nằm ở ExamAnswerBoolean).
  isCorrect  Boolean @default(false)
  // Chỉ dùng cho TRUE_FALSE_CLUSTER: "a" | "b" | "c" | "d" — null với MC/ESSAY.
  subLabel   String?

  question       ExamQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers        ExamAnswer[]
  booleanAnswers ExamAnswerBoolean[]

  @@index([questionId])
  @@map("exam_options")
}

// Một lần học viên làm bài. Thời gian làm bài enforce ở server qua expiresAt,
// không tin đồng hồ đếm ngược phía client.
model ExamAttempt {
  id          String    @id @default(cuid())
  userId      String
  examId      String
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  status      String    @default("in_progress") // "in_progress" | "submitted" | "expired"
  score       Float?
  totalPoints Float? // snapshot sum(points) lúc bắt đầu

  // Snapshot thứ tự đã xáo lúc tạo attempt — cố định suốt 1 lượt, xáo lại
  // hoàn toàn ở lượt sau. questionOrder: mảng ExamQuestion.id theo thứ tự
  // hiển thị. optionOrderByQuestion: { [questionId]: ExamOption.id[] }.
  questionOrder         Json?
  optionOrderByQuestion Json?

  // Giám sát thoát tab/rời màn hình — chỉ đếm sự kiện, không quay màn hình
  // (giống cơ chế Azota). tabSwitchLog: mảng ISO timestamp mỗi lần rời tab.
  tabSwitchCount Int   @default(0)
  tabSwitchLog   Json?

  // Mốc hết giờ từng Phần, tính 1 lần lúc bắt đầu attempt, cố định suốt
  // lượt thi. null = đề này không dùng giờ riêng Phần (hành vi cũ — chỉ 1
  // đồng hồ chung qua expiresAt). Dạng [{ label: string|null, endsAt: ISO
  // string }], cộng dồn theo thứ tự Phần xuất hiện trong đề — phần tử cuối
  // == expiresAt ở trên (xem computeSectionWindows trong examGrading.ts).
  sectionWindows Json?

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam           Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers        ExamAnswer[]
  booleanAnswers ExamAnswerBoolean[]
  corrections    ExamCorrection[]

  @@index([userId, examId])
  @@index([examId, status])
  @@map("exam_attempts")
}

// Trả lời cho câu MC (optionId) hoặc ESSAY (textAnswer) — 1 câu hỏi luôn có
// đúng 1 dòng ExamAnswer/attempt. Câu TRUE_FALSE_CLUSTER dùng bảng riêng
// ExamAnswerBoolean bên dưới vì cần 4 câu trả lời độc lập cho 1 câu hỏi.
model ExamAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String? // null = chưa trả lời (MC) hoặc câu ESSAY
  textAnswer String?  @db.Text // chỉ dùng cho câu ESSAY
  answeredAt DateTime @updatedAt

  // Chấm tay câu ESSAY (Giai đoạn 6) — null = chưa chấm, không phải 0 điểm.
  // Không dùng cho MC/CLUSTER (chấm tự động lúc nộp bài).
  pointsAwarded  Float?
  teacherComment String? @db.Text

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   ExamOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@map("exam_answers")
}

// Trả lời cho từng mệnh đề con (subLabel a/b/c/d) của 1 câu TRUE_FALSE_CLUSTER
// — mỗi mệnh đề là 1 dòng riêng vì học sinh đánh đúng/sai độc lập cho từng ý,
// không phải chọn 1 trong 4 như MC (nên không dùng chung ExamAnswer được).
model ExamAnswerBoolean {
  id         String   @id @default(cuid())
  attemptId  String
  optionId   String // ExamOption của mệnh đề con (có subLabel)
  answerTrue Boolean? // null = chưa trả lời ý này
  answeredAt DateTime @updatedAt

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  option  ExamOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, optionId])
  @@map("exam_answer_booleans")
}

// QZ-11: số lượt làm tối đa của một đề/quiz, ở BẢNG RIÊNG, KHÔNG có khoá ngoại tới Exam, để không đụng model Exam (đề bị xoá thì dòng này mồ côi, vô hại). Không có dòng = không giới hạn (hành vi cũ).
// Máy chủ kiểm lúc bắt đầu lượt mới (exams/[id]/start); lượt đang làm dở luôn được tiếp tục. Chưa có màn soạn: gia sư đặt qua mã sau.
model QuizAttemptLimit {
  examId      String   @id
  maxAttempts Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("quiz_attempt_limits")
}

// NV-188 — Chữa bài: gợi ý trước, đáp án sau, nhưng có điểm dừng. Một dòng cho mỗi (lượt thi × câu sai).
// Chỉ để HỌC: không bao giờ đụng ExamAttempt.score / ExamAnswer (điểm tính theo lần nộp đầu, lúc nộp bài).
//   tries    — số lần nộp ở màn chữa bài (tối đa 2 có ý nghĩa; lần 2 sai thì hiện đáp án)
//   solved   — đã chọn/điền đúng
//   revealed — đã được xem đáp án (nộp sai lần 2, bấm "Xem đáp án", hoặc câu không có gợi ý sai lần 1)
model ExamCorrection {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  tries      Int      @default(0)
  solved     Boolean  @default(false)
  revealed   Boolean  @default(false)
  lastOptionId String? // MC: lựa chọn của lần nộp gần nhất
  lastText     String? @db.Text // SHORT_ANSWER: câu trả lời của lần nộp gần nhất
  lastOptionIds String[] @default([]) // MC_MULTI: các ô đã chọn ở lần nộp gần nhất (cột THÊM, mặc định rỗng; câu MC / điền ngắn không dùng)
  reflection   String? @db.Text // ô không bắt buộc: "gợi ý ở trên giúp bạn ở chỗ nào?"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("exam_corrections")
}

// QZ-07 — Nhật ký thay đổi của một quiz/đề (tạo, phát hành, tạo phiên bản mới, sửa trực tiếp khi chưa ai làm…). Bảng MỚI, chỉ thêm dòng, không sửa/xoá dòng.
// Không có quan hệ cứng tới Exam để nhật ký còn nguyên cả khi xoá một bản nháp. actorId = gia sư thực hiện.
model ExamChangeLog {
  id         String   @id @default(cuid())
  examId     String
  rootExamId String?
  actorId    String?
  kind       String // "create" | "publish" | "edit" | "new_version" | "import" | "version_published" | "discard"
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([examId, createdAt])
  @@index([rootExamId, createdAt])
  @@map("exam_change_logs")
}

// ─── BÁO CÁO THÁNG GỬI PHỤ HUYNH (NV-185/186/189) ─────────────────────────────
// Một báo cáo = (gia sư × học sinh × tháng), chỉ gồm các môn/lớp của gia sư đó. Số liệu (chuyên cần, nỗ lực,
// năng lực) luôn TÍNH LẠI từ dữ liệu thật khi gia sư mở; bảng này chỉ lưu phần gia sư soạn và phần đã duyệt:
//   draftItems       — các dòng "Điều chưa đạt tháng này" gia sư đang đọc/sửa (KiN chỉ gợi ý sẵn)
//   approvedItems    — bản gia sư đã bấm "Duyệt": phụ huynh trên "Sổ của con" CHỈ thấy bản này
//   approvedSnapshot — số liệu từng môn đóng băng lúc duyệt, để phiếu phụ huynh không đổi sau đó
//   zaloOpenedAt     — gia sư đã MỞ Zalo với tin soạn sẵn (KiN không biết tin có đi thật hay không)
// KiN Pro F3 "Giấy tờ có thương hiệu": cài đặt của gia sư (tên hiển thị, màu nhấn từ danh sách token, chữ ký chữ). Chưa có logo tải lên.
model TutorDocBrand {
  userId      String   @id
  displayName String
  accent      String // khoá trong src/lib/docBrand.ts (ACCENTS), KHÔNG phải mã màu
  signature   String   @default("")
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_doc_brands")
}

model MonthlyReport {
  id               String    @id @default(cuid())
  tutorId          String
  studentId        String
  yearMonth        String // "YYYY-MM" theo giờ VN
  draftItems       Json?
  approvedItems    Json?
  approvedSnapshot Json?
  approvedAt       DateTime?
  zaloOpenedAt     DateTime?
  // KiN Pro F3: lúc gia sư tạo bản IN có thương hiệu + ảnh chụp thương hiệu lúc đó (bản đã tạo xem lại được dù hết hạn Pro).
  brandedAt        DateTime?
  brandSnapshot    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tutor   User @relation("ReportTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student User @relation("ReportStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tutorId, studentId, yearMonth])
  @@index([studentId, yearMonth])
  @@map("monthly_reports")
}

// Admin (trung tâm/giáo viên sở hữu đề) gắn cờ này thủ công sau khi xác nhận
// guest đã trả phí qua quy trình sales hiện có (KHÔNG có cổng thanh toán tự
// động — xem plan Giai đoạn 3, reports/2026-07-13.md). Có bản ghi = được thi.
model ExamGuestAccess {
  id        String   @id @default(cuid())
  userId    String
  examId    String
  grantedBy String // userId của admin/giáo viên đã duyệt
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@map("exam_guest_access")
}

// Ngân hàng đề thi — chỉ lưu trữ file đề gốc (PDF/Word) để xem/tải lại sau,
// KHÔNG tự động tách câu khi upload. Tách câu là hành động riêng, chủ động
// (nút "Tách câu hỏi", xem src/app/api/exam-files/[id]/extract/route.ts) —
// tái dùng đúng pipeline AI-extract sẵn có (src/lib/aiExamImport.ts) rồi đưa
// người soạn qua màn hình gán Đầu mục (QuestionCategory) trước khi lưu vào
// Ngân hàng câu hỏi, không tự động lưu thẳng.
model ExamFile {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String // mime type gốc, để biết cách hiển thị/tách
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  // null = "Chưa phân loại". Xoá thư mục KHÔNG xoá theo file (SetNull) — API
  // xoá thư mục vẫn tự chặn nếu còn file để tránh mất tổ chức, xem
  // exam-file-folders/[id]/route.ts.
  folderId String?
  folder   ExamFileFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([folderId])
  @@map("exam_files")
}

// Thư mục Ngân hàng đề thi — 1 CẤP PHẲNG (không thư mục lồng thư mục, khác
// QuestionCategory). Có chủ sở hữu (khác QuestionCategory dùng chung) — mỗi
// giáo viên tự tổ chức file của mình, cùng quy tắc ownerScopeWhere/
// requireOwnedResource như ExamFile.
model ExamFileFolder {
  id        String   @id @default(cuid())
  name      String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  files ExamFile[]

  @@index([ownerId])
  @@map("exam_file_folders")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  phone         String?
  // Số di động ĐÃ XÁC MINH bằng mã SMS (E.164, "+84901234567") — chỉ số này mới đăng nhập được bằng SMS. KHÔNG @unique trên `phone`
  // vì đó là ô tự khai, nhiều người có thể khai cùng một số; unique ở đây vì mỗi số chỉ gắn được với MỘT tài khoản (NULL thì không giới hạn).
  // Đổi `phone` sang số khác thì xoá cả hai cột này (xem src/lib/phoneVerify.ts).
  phoneE164       String?   @unique
  phoneVerifiedAt DateTime?
  dateOfBirth   DateTime? // dùng để tính tuổi tại backend cho ngưỡng xác nhận phụ huynh (D04) — không suy đoán từ input khác
  // 23/10/2026 (D04): lúc CHÍNH học sinh tự bấm đồng ý để gia sư ghi thông tin lớp học của em (đồng ý kép từ 7 tuổi, tự đồng ý từ 16).
  // null = em chưa bấm. Cột nullable nên không mất dữ liệu cũ. Về null khi em thu hồi.
  selfConsentAt DateTime?
  parentPhone   String? // dữ liệu cũ, tự khai — KHÔNG dùng để cấp quyền; nguồn tin cậy là ParentLink đã verified
  parentName    String? // dữ liệu cũ, tự khai — xem ghi chú parentPhone
  school        String?
  highSchool    String?
  city          String?
  studentId     Int?     @unique
  avatarBase64  String?  @db.Text
  facebookUrl   String?
  zaloPhone     String?
  role          String   @default("student") // "student" | "admin"
  adminRole     String? // "admin_super" | "admin_content" | "teacher"
  emailVerified Boolean  @default(false)
  banned        Boolean  @default(false)
  createdAt     DateTime @default(now())

  // ─── Hồ sơ gia sư (1.4.4) — field phẳng, nhất quán avatarBase64/facebookUrl.
  // Người đăng ký gia sư giữ role "student" cho tới khi admin duyệt (KHÔNG
  // cấp role "admin" ngay — nhiều route coi role "admin" là toàn quyền xem
  // nội dung). Duyệt xong mới thành role "admin" + adminRole "teacher".
  bio               String?   @db.Text
  subjects          String[]  @default([])
  tutorAppliedAt    DateTime? // != null = đã nộp đơn làm gia sư
  // TT-203 + TK-167: lựa chọn giao diện LƯU THEO TÀI KHOẢN (không theo máy). JSON có
  // schema chặt, chỉ đọc/ghi qua src/lib/userPreferences.ts: modules (module gia sư bật
  // thêm ngoài Lịch + Học phí), theme/mode (TK-167), reminders (tắt/bật nhắc từng bên).
  preferences       Json?
  tutorVerified     Boolean   @default(false)
  tutorVerifiedAt   DateTime?
  tutorVerifiedBy   String?   // userId admin đã duyệt
  tutorRejectedAt   DateTime?
  tutorRejectReason String?
  // PH-212: quản trị khoá hồ sơ giả / bị báo cáo → hồ sơ công khai trả 404, gia sư vẫn dùng sổ lớp bình thường.
