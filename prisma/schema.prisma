  reminderLogsTutor    ClassReminderLog[]  @relation("ReminderTutor")
  parentLinksAsParent  ParentLink[] @relation("ParentLinks")
  parentLinksAsStudent ParentLink[] @relation("StudentLinks")
  auditLogs            AuditLog[]
  createdClassInvites  ClassInvite[] @relation("ClassInviteCreator")
  topupRequests        CoinTopupRequest[] @relation("TopupRequests")
  topupReviews         CoinTopupRequest[] @relation("TopupRequestReviews")
