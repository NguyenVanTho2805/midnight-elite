generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── COURSES ──────────────────────────────────────────────────────────────────

model Course {
  id            String   @id // slug: "hsa-tron-goi"
  adminId       Int      @unique
  sortOrder     Int      @unique @default(autoincrement()) // thứ tự hiển thị trên trang công khai (theo thứ tự tạo)
  name          String // tên công khai
  adminName     String // tên nội bộ
  // PH-215/216: link nhóm Zalo của lớp (https://zalo.me/g/…) — "cổng phụ huynh" không bắt tải app. Tin vào nhóm chỉ là tin chung.
  zaloGroupUrl  String?
  shortTitle    String
  category      String
  instructor    String
  teacherAvatar String
  openDate      String
  types         String[]
  tag           String?
  tagColor      String?
  bg            String
  strip         String   @default("#FDE047")
  introVideo    String?
  zaloGroupLink String?
  price         Int
  originalPrice Int?
  lessons       Int      @default(0)
  hours         Int      @default(0)
  status        Boolean  @default(true)
  createdAt     String

  // Sức chứa tối đa của lớp — null = không giới hạn. Áp dụng khi tạo
  // Enrollment mới (ClassInvite.redeem + mua Subscription), không ảnh hưởng
  // Enrollment đã có.
  capacity Int?

  // Trạng thái vận hành của lớp (không trùng `status` ở trên — `status` là cờ
  // ẩn/hiện công khai dạng Boolean, giữ nguyên vì có nhiều route đang đọc).
  //   - "open"   : đang nhận thêm học viên (mặc định)
  //   - "closed" : đã đóng, không nhận thêm — Enrollment cũ vẫn hoạt động
  //   - "paused" : tạm ngừng cả hoạt động mới lẫn hiện có
  classStatus String @default("open")

  // Giáo viên sở hữu (null = nội dung cũ/của quản lý trung tâm). Chỉ dùng để
  // scope quyền khi User.adminRole === "teacher" — admin_super/admin_content
  // luôn thấy & sửa được mọi Course bất kể ownerId.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  sections         Section[]
  enrollments      Enrollment[]
  cartItems        CartItem[]
  reviews          CourseReview[]
  exams            Exam[]
  classSchedules   ClassSchedule[]
  classAbsences    ClassAbsence[]
  makeupCredits    MakeupCredit[]
  sessionChanges   ClassSessionChange[]
  reminderLogs     ClassReminderLog[]
  coinTransactions CoinTransaction[]
  threads          Thread[]
  classInvites       ClassInvite[]
  monthlyFees        MonthlyCourseFee[]
  attendanceSessions AttendanceSession[]
  feeRates           CourseFeeRate[]
  studentFeeRates    CourseStudentRate[]
  feeCharges         FeeCharge[]

  // HP-15 (23/10/2026): cách tính học phí của lớp, CHỌN LÚC TẠO LỚP và chỉ lớp tạo sau mới khác mặc định.
  //   "monthly_sessions" (mặc định, MỌI lớp cũ) : gia sư nhập số buổi tháng (MonthlyCourseFee) — cách tính hiện tại, KHÔNG đổi.
  //   "per_session" | "per_hour" | "per_course" : học phí sinh ra từ buổi đã điểm danh (FeeCharge), đơn giá ở CourseFeeRate.
  feeMode String @default("monthly_sessions")

  @@index([ownerId])
  @@map("courses")
}

// Khung giờ học cố định lặp lại hàng tuần của 1 khoá (kiểu TKB) — KHÔNG phải
// 1 dòng cho từng buổi cụ thể, mà là 1 quy luật lặp (vd "Thứ 2 & Thứ 5,
// 19h-21h"). /api/schedule tự tính ra buổi học sắp tới từ quy luật này cho
// từng học viên theo khoá đã đăng ký, giống cách nó đang tự tính lịch thi từ
// Exam.date — không cần tạo bản ghi riêng cho từng tuần.
model ClassSchedule {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=CN, 1=T2 ... 6=T7 (khớp Date.getDay() của JS)
  startTime String // "19:00"
  endTime   String // "21:00"
  note      String? // vd "Học live qua Zoom" — hiện kèm trong lịch/email nhắc
  joinUrl   String? // link vào lớp (Meet/Zoom) — in vào tin nhắc lịch (TT-201); trống thì tin bỏ dòng này
  active    Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([courseId])
  @@map("class_schedules")
}

// "Theo dõi lớp" (BE-079, chốt 06/10/2026). Trước đây là giỏ hàng; theo D01
// học viên học miễn phí nên bỏ khái niệm giỏ hàng, chỉ còn danh sách lớp học
// viên quan tâm. Giữ tên model/bảng cart_items để `db push` khi build không
// xoá dữ liệu các lớp người dùng đã lưu.
model CartItem {
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@map("cart_items")
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int // 1–5
  comment   String   @db.Text
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("course_reviews")
}

// ─── CURRICULUM ───────────────────────────────────────────────────────────────

model Section {
  id       String    @id
  title    String
  order    Int       @default(0)
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@map("sections")
}

model Chapter {
  id        String   @id
  title     String
  order     Int      @default(0)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@map("chapters")
}

model Lesson {
  id             String           @id
  code           String
  title          String
  type           String // "record" | "live" | "quiz" | "document"
  duration       String?
  videoUrl       String?
  zoomUrl        String?
  azotaUrl       String?
  azotaDeadline  String?
  documents      String?          @default("[]")
  adminNote      String?
  isLocked       Boolean          @default(true)
  isFree         Boolean          @default(false)
  statsVideos    Int              @default(0)
  statsMaterials Int              @default(0)
  statsViews     Int              @default(0)
  order          Int              @default(0)
  chapterId      String
  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress       LessonProgress[]
  notes          LessonNote[]
  azotaDone      LessonAzotaDone[]
  assignments    Assignment[]

  @@map("lessons")
}

// Bài tập tự nộp trên nền tảng — song song với Lesson.azotaUrl (link Azota
// ngoài), KHÔNG thay thế. 1 Lesson có thể có nhiều Assignment (giống
// azotaUrls cho phép nhiều link/lesson). Điểm bài tập là chỉ số RIÊNG, không
// gộp vào công thức GPA (xem computeAssignmentAverage trong src/lib/gpa.ts).
model Assignment {
  id           String    @id @default(cuid())
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  instructions String?   @db.Text
  fileUrl      String? // đề bài giáo viên cung cấp — học viên tải về làm, null = chỉ có hướng dẫn text
  fileName     String?
  maxPoints    Float     @default(10)
  dueDate      DateTime?

  // "file" (nộp file, mặc định — hành vi cũ giữ nguyên) | "interactive"
  // (làm trực tiếp trên web, câu hỏi AI trích từ file — xem
  // AssignmentQuestion). dueDate BẮT BUỘC khi mode="interactive" (ép ở tầng
  // API, không ép được ở DB vì "file" vẫn cho phép để trống) — dueDate vừa
  // là mốc khoá bài vừa là mốc tự hiện đáp án đúng/sai cho học viên, so
  // sánh ĐỘNG mỗi lần gọi (không snapshot) nên sửa lại dueDate muộn hơn sẽ
  // tự mở khoá lại, sớm hơn thì tự khoá lại ngay.
  mode String @default("file")

  // Xem ghi chú ở Course.ownerId — cùng quy tắc scope quyền (chỉ chủ sở
  // hữu/admin_content/admin_super sửa/xoá/chấm).
  ownerId String?
  owner   User?   @relation("OwnedAssignments", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions AssignmentSubmission[]
  questions   AssignmentQuestion[]

  @@index([lessonId])
  @@map("assignments")
}

// Bài học viên nộp cho 1 Assignment — @@unique([assignmentId, userId]) nghĩa
// là nộp lại sẽ GHI ĐÈ bản cũ (không tích luỹ nhiều lần nộp). Nộp lại một bài
// đã chấm sẽ xoá score/gradedAt/comment cũ (bắt chấm lại), tránh điểm cũ gắn
// nhầm với nội dung đã sửa — xem submit/route.ts.
model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("AssignmentSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String?
  // "file" (tệp tải lên, mặc định: hành vi cũ) | "link" (học sinh dán LINK bài làm Azota; fileUrl giữ link đó) | "done" (chỉ bấm "Em đã làm xong", fileUrl rỗng).
  // KHÔNG có loại ảnh: KiN không nhận ảnh bài làm của học sinh dưới 16 tuổi (xem src/lib/mediaLink.ts validateWorkLink).
  kind         String     @default("file")
  submittedAt  DateTime   @default(now())

  // null = chưa chấm. Cả 2 field dưới null nếu chưa chấm.
  score    Float?
  comment  String?   @db.Text
  gradedAt DateTime?
  gradedBy String? // userId giáo viên đã chấm gần nhất

  @@unique([assignmentId, userId])
  @@map("assignment_submissions")
}

// Câu hỏi của bài tập kiểu "interactive" — AI trích từ file giáo viên tải
// lên (dùng chung extractQuestionsFromFiles với Thi thử), nhưng lưu RIÊNG,
// không đụng vào Ngân hàng câu hỏi. Chỉ 2 loại cho bản đầu: MC/ESSAY.
model AssignmentQuestion {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  order        Int
  text         String     @db.Text
  imageUrl     String?
  points       Float      @default(1)
  type         String     @default("MC") // "MC" | "ESSAY"
  explanation  String?    @db.Text

  options AssignmentOption[]
  answers AssignmentAnswer[]

  @@index([assignmentId])
  @@map("assignment_questions")
}

model AssignmentOption {
  id         String             @id @default(cuid())
  questionId String
  question   AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  isCorrect  Boolean            @default(false)

  answers AssignmentAnswer[]

  @@index([questionId])
  @@map("assignment_options")
}

// 1 dòng / học viên / câu hỏi — upsert theo (userId, questionId) mỗi lần
// trả lời (autosave, không có nút "Nộp bài"). isCorrect tính ngầm ngay lúc
// lưu với câu MC (so optionId với AssignmentOption.isCorrect), nhưng API
// đọc bài làm PHẢI ẩn field này với chính học viên đó cho tới khi qua
// Assignment.dueDate — chỉ ẩn ở tầng API, không ẩn được ở DB.
model AssignmentAnswer {
  id         String             @id @default(cuid())
  questionId String
  question   AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation("AssignmentAnswers", fields: [userId], references: [id], onDelete: Cascade)

  optionId String?
  option   AssignmentOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  textAnswer String? @db.Text // câu ESSAY

  isCorrect Boolean? // MC: tự chấm ngay. ESSAY: luôn null, không dùng field này để chấm.

  // ESSAY: giáo viên chấm tay — null nghĩa là chưa chấm.
  pointsAwarded  Float?
  teacherComment String? @db.Text

  updatedAt DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([questionId])
  @@map("assignment_answers")
}

// ─── EXAMS ────────────────────────────────────────────────────────────────────

model Exam {
  id           String  @id
  code         String  @unique
  title        String
  category     String
  date         String
  time         String
  duration     String
  questions    Int
  status       String // "upcoming" | "available" | "completed"
  azotaUrl     String? @default("")
  participants Int     @default(0)
  active       Boolean @default(true)
  activeGuest  Boolean @default(true)
  guestCanTake Boolean @default(false)
  createdAt    String

  // Xem ghi chú ở Course.ownerId — cùng quy tắc scope quyền.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Đề thi có thể gắn với 1 khoá học cụ thể (null = đề thi chung, không thuộc
  // khoá nào). Dùng để quyết định ai được thi miễn phí khi có price: học viên
  // đã Enrollment vào courseId này thì miễn phí, còn lại phải có ExamGuestAccess.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // null/0 = miễn phí cho tất cả (theo activeGuest/guestCanTake như cũ).
  // Có giá trị = học viên đã đăng ký courseId ở trên thi miễn phí, người khác
  // (guest hoặc học viên khoá khác) cần được duyệt qua ExamGuestAccess.
  price Int?

  // Thang % điểm câu Đúng-Sai 4 ý theo số ý trả lời đúng — mảng 4 số [1 ý,
  // 2 ý, 3 ý, 4 ý đúng] tính theo %, vd [10,25,50,100]. null = dùng mặc định
  // (xem CLUSTER_PERCENT_BY_CORRECT_COUNT trong src/lib/examGrading.ts).
  clusterScorePercents Json?

  // Tổng điểm hiển thị cuối cùng cho học viên (thang quy đổi, KHÁC với tổng
  // điểm thô = sum(ExamQuestion.points)) — điểm thô luôn được rescale về
  // đúng thang này khi chấm (xem finalizeAttempt/regradeAttempt trong
  // src/lib/examGrading.ts). Mặc định 150 để khớp hành vi hardcode trước đây.
  totalPoints Float @default(150)

  // null = không yêu cầu mật khẩu. Có giá trị = học viên phải nhập đúng mật
  // khẩu này mới bắt đầu làm bài được (đọc tại chỗ trong phòng thi có giám
  // sát, giống Azota) — KHÔNG BAO GIỜ trả field này qua API GET, chỉ trả
  // `hasPassword: boolean` (xem exams/route.ts, exams/[id]/route.ts).
  password String?

  // QZ-14: mật khẩu vào thi ở dạng BĂM (bcrypt của sha256, xem src/lib/examPassword.ts). Đề mới/đặt lại chỉ ghi cột này và để `password` null.
  // Đề cũ còn `password` thô vẫn dùng được (đọc tương thích) và tự nâng lên băm. Không bao giờ trả qua API.
  passwordHash String?

  // true = học viên xem được bảng xếp hạng Top 10 của đề này; false = ẩn
  // hoàn toàn (giáo viên không muốn học viên so điểm công khai).
  showLeaderboard Boolean @default(true)

  // Khi nào học viên xem được màn "Xem lại bài làm" (đáp án đúng/giải thích):
  // "never" | "after_submit" (ngay sau khi nộp) | "after_exam_ends" (chỉ sau
  // khi hết thời hạn làm bài của đề — tính từ date+time+duration, xem
  // hasExamWindowEnded() trong src/lib/examGrading.ts).
  answerVisibility String @default("after_submit")

  // true = câu học sinh trả lời SAI chỉ hiện "Sai", không lộ đáp án đúng thật
  // (chặn kiểu nộp bừa để dò đáp án rồi thi lại) — áp dụng khi answerVisibility
  // đã cho phép xem đáp án. Câu trả lời ĐÚNG vẫn luôn hiện đáp án bình thường.
  hideAnswerForWrong Boolean @default(false)

  results       ExamResult[]
  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]
  guestAccess   ExamGuestAccess[]

  @@index([ownerId])
  @@index([courseId])
  @@map("exams")
}

// Ngân hàng câu hỏi dùng chung giữa các giáo viên — kho bản mẫu ĐỘC LẬP với
// ExamQuestion, KHÔNG share row trực tiếp: ExamAnswer trỏ thẳng vào row sống
// của câu hỏi/đáp án trong đề (không phải snapshot đóng băng), nên sửa/xoá 1
// câu dùng chung sẽ phá lịch sử chấm điểm của học viên đã thi. Khi thêm 1 câu
// từ ngân hàng vào đề (tính năng sau), hệ thống COPY nội dung thành
// ExamQuestion mới — ngân hàng và đề sau đó hoàn toàn độc lập.
model QuestionBankItem {
  id          String   @id @default(cuid())
  type        String   @default("MC") // "MC" | "ESSAY" | "TRUE_FALSE_CLUSTER" | "SHORT_ANSWER" — giống ExamQuestion.type
  text        String   @db.Text
  imageUrl    String?
  points      Float    @default(1)
  explanation String?  @db.Text
  hint        String?  @db.Text // NV-188 — gợi ý cho màn Chữa bài, copy sang ExamQuestion.hint khi rút vào đề

  // Đầu mục phân cấp (thay subject/topic phẳng cũ) — lá của cây
  // QuestionCategory, dùng để thu hẹp phạm vi so trùng khi phát hiện trùng
  // lặp, và để lọc/tìm trong danh sách. Bắt buộc chọn 1 đầu mục cụ thể (có
  // thể ở bất kỳ tầng nào của cây).
  categoryId String
  category   QuestionCategory @relation(fields: [categoryId], references: [id])
  difficulty String // "NB" | "TH" | "VD" | "VDC" (nhận biết/thông hiểu/vận dụng/vận dụng cao)
  tags       Json? // string[] tự do, tùy chọn

  // Hash nội dung đã chuẩn hoá (xem computeContentHash trong
  // src/lib/questionDedup.ts) — tra trùng Y HỆT trong phạm vi categoryId
  // (Giai đoạn 3.5 Cấp 1). null = chưa từng tính (bản ghi cũ trước tính năng
  // này, được tính lại khi sửa).
  contentHash String?

  // Giai đoạn 3.5 Cấp 3 — vector embedding (Gemini gemini-embedding-001, 768
  // chiều) để tra trùng GIỐNG NGHĨA (semantic), khác Cấp 1 (y hệt/hash) và
  // Cấp 2 (giống chuỗi/pg_trgm). `Unsupported` vì Prisma Client không thao
  // tác trực tiếp kiểu `vector` — mọi đọc/ghi cột này đều qua $queryRaw/
  // $executeRaw trong src/lib/embeddings.ts. null = chưa từng tính (bản ghi
  // cũ trước tính năng này, hoặc lần gọi Gemini gần nhất lỗi — không chặn
  // lưu câu hỏi nếu tính embedding thất bại, chỉ đơn giản bỏ qua câu đó khi
  // so Cấp 3 lần sau, được tính lại khi sửa).
  embedding Unsupported("vector(768)")?

  // Giai đoạn 6 — quy trình duyệt. "draft" (đang soạn, chỉ chủ sở hữu +
  // admin_content/admin_super thấy) | "pending" (đã gửi duyệt, chờ admin
  // xét) | "approved" (đã duyệt, vào kho dùng chung — CHỈ trạng thái này mới
  // được rút vào đề qua QuestionBankPicker/AutoDrawModal). Mặc định
  // "approved" để KHÔNG đổi hành vi của mọi bản ghi đã có trước Giai đoạn 6
  // (route tạo/sửa mới sẽ tự set giá trị tường minh, default chỉ áp cho dữ
  // liệu cũ). admin_content/admin_super tạo/sửa → luôn "approved" ngay
  // (không cần tự duyệt bài của mình); "teacher" tạo → "draft", phải chủ
  // động gửi duyệt (PATCH .../submit) mới thành "pending".
  status String @default("approved")

  // Lý do admin từ chối lần gần nhất — chỉ có ý nghĩa khi status="draft" sau
  // khi bị từ chối (khác "draft" do chưa từng gửi, lúc đó null). Xoá khi gửi
  // duyệt lại.
  rejectionReason String? @db.Text
  reviewedBy      String? // userId admin đã duyệt/từ chối gần nhất
  reviewedAt      DateTime?

  // Người soạn — dùng chung giữa mọi giáo viên (ai cũng xem/lọc được tất cả),
  // nhưng chỉ chủ sở hữu (hoặc admin_super/admin_content) mới sửa/xoá được,
  // xem ownsResource()/requireOwnedResource() trong src/lib/auth-guard.ts.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options       QuestionBankOption[]
  examQuestions ExamQuestion[]

  @@index([categoryId])
  @@index([categoryId, contentHash])
  @@index([status])
  @@map("question_bank_items")
}

// Cây đầu mục phân cấp không giới hạn số tầng (vd Môn → Chương → Bài →
// Dạng bài) — thay cho subject/topic phẳng cũ của QuestionBankItem. Dùng
// chung giữa mọi giáo viên (ai cũng xem/chọn được, sửa/xoá qua trang quản lý
// riêng — không có khái niệm chủ sở hữu, khác Course/Exam/QuestionBankItem).
// KHÔNG đặt onDelete: Cascade ở quan hệ cha-con hay ở QuestionBankItem.category
// — API xoá phải tự chặn khi còn con hoặc còn câu hỏi gắn vào, tránh xoá
// nhầm cả nhánh cây (xem src/app/api/question-categories/[id]/route.ts).
model QuestionCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    QuestionCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  QuestionCategory[] @relation("CategoryTree")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  bankItems QuestionBankItem[]

  @@index([parentId])
  @@map("question_categories")
}

model QuestionBankOption {
  id        String  @id @default(cuid())
  itemId    String
  order     Int     @default(0)
  text      String  @db.Text
  isCorrect Boolean @default(false)
  subLabel  String? // chỉ dùng cho TRUE_FALSE_CLUSTER: "a"|"b"|"c"|"d"

  item QuestionBankItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("question_bank_options")
}

// Câu hỏi thi trắc nghiệm trong platform — KHÔNG liên quan đến model
// Question/Answer bên dưới (đó là module Hỏi Đáp cộng đồng, khác hoàn toàn).
model ExamQuestion {
  id          String   @id
  examId      String
  order       Int      @default(0)
  text        String   @db.Text
  imageUrl    String?
  points      Float    @default(1)
  explanation String?  @db.Text
  // NV-188: gợi ý do gia sư viết khi soạn câu hỏi. Chỉ hiện ở màn Chữa bài sau lần nộp đầu SAI, và không
  // bao giờ gửi cho học viên lúc đang làm bài. Trống = bỏ bước gợi ý (hiện đáp án sau lần nộp đầu).
  hint        String?  @db.Text
  createdAt   DateTime @default(now())

  // "MC" (trắc nghiệm 1 đáp án, mặc định) | "ESSAY" (tự luận, chấm tay) |
  // "TRUE_FALSE_CLUSTER" (1 đoạn dẫn + 4 mệnh đề con, mỗi ý tự đúng/sai độc
  // lập — không phải chọn 1 trong 4, xem ExamOption.subLabel/ExamAnswerBoolean) |
  // "SHORT_ANSWER" (điền đáp án ngắn, chấm tự động so khớp text — đáp án đúng
  // lưu trong ExamOption duy nhất của câu, xem examGrading.ts).
  type String @default("MC")

  // Tên Phần thi (vd "Phần Trắc nghiệm") để nhóm hiển thị — null = không
  // thuộc phần nào (đề cũ, hoặc đề không cần chia phần). Chỉ dùng để nhóm
  // hiển thị + xáo trong phạm vi từng phần (shuffleQuestionOrderBySections
  // trong examGrading.ts), không ảnh hưởng tới cách tính điểm.
  sectionLabel String?

  // Số phút riêng cho Phần này (vd đề ĐGNL HSA: mỗi Phần có giờ riêng, hết
  // giờ Phần nào khoá Phần đó). Lặp lại giống nhau ở mọi câu cùng
  // sectionLabel — admin tự nhập đồng bộ. null = không dùng giờ riêng Phần
  // (xem computeSectionWindows trong examGrading.ts để biết điều kiện bật).
  sectionMinutes Int?

  // Truy vết câu này được copy từ đâu trong Ngân hàng câu hỏi (null = soạn
  // tay/AI trích xuất, không từ ngân hàng). CHỈ để tham khảo nguồn gốc — nội
  // dung đã copy độc lập hoàn toàn, sửa/xoá câu gốc trong ngân hàng KHÔNG
  // ảnh hưởng câu này (onDelete: SetNull, không Cascade — xem ghi chú ở
  // QuestionBankItem về nguyên tắc không share row).
  sourceBankItemId String?
  sourceBankItem   QuestionBankItem? @relation(fields: [sourceBankItemId], references: [id], onDelete: SetNull)

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  options ExamOption[]
  answers ExamAnswer[]
  corrections ExamCorrection[]

  @@index([examId, order])
  @@map("exam_questions")
}

model ExamOption {
  id         String  @id
  questionId String
  order      Int     @default(0) // vị trí A/B/C/D suy ra từ order, không lưu chữ cái
  text       String  @db.Text
  // MC: đây có phải đáp án đúng không. TRUE_FALSE_CLUSTER: mệnh đề này có
  // đúng không (giá trị đúng/sai thật của phát biểu, không phải câu trả lời
  // của học sinh — câu trả lời của học sinh nằm ở ExamAnswerBoolean).
  isCorrect  Boolean @default(false)
  // Chỉ dùng cho TRUE_FALSE_CLUSTER: "a" | "b" | "c" | "d" — null với MC/ESSAY.
  subLabel   String?

  question       ExamQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers        ExamAnswer[]
  booleanAnswers ExamAnswerBoolean[]

  @@index([questionId])
  @@map("exam_options")
}

// Một lần học viên làm bài. Thời gian làm bài enforce ở server qua expiresAt,
// không tin đồng hồ đếm ngược phía client.
model ExamAttempt {
  id          String    @id @default(cuid())
  userId      String
  examId      String
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  status      String    @default("in_progress") // "in_progress" | "submitted" | "expired"
  score       Float?
  totalPoints Float? // snapshot sum(points) lúc bắt đầu

  // Snapshot thứ tự đã xáo lúc tạo attempt — cố định suốt 1 lượt, xáo lại
  // hoàn toàn ở lượt sau. questionOrder: mảng ExamQuestion.id theo thứ tự
  // hiển thị. optionOrderByQuestion: { [questionId]: ExamOption.id[] }.
  questionOrder         Json?
  optionOrderByQuestion Json?

  // Giám sát thoát tab/rời màn hình — chỉ đếm sự kiện, không quay màn hình
  // (giống cơ chế Azota). tabSwitchLog: mảng ISO timestamp mỗi lần rời tab.
  tabSwitchCount Int   @default(0)
  tabSwitchLog   Json?

  // Mốc hết giờ từng Phần, tính 1 lần lúc bắt đầu attempt, cố định suốt
  // lượt thi. null = đề này không dùng giờ riêng Phần (hành vi cũ — chỉ 1
  // đồng hồ chung qua expiresAt). Dạng [{ label: string|null, endsAt: ISO
  // string }], cộng dồn theo thứ tự Phần xuất hiện trong đề — phần tử cuối
  // == expiresAt ở trên (xem computeSectionWindows trong examGrading.ts).
  sectionWindows Json?

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam           Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers        ExamAnswer[]
  booleanAnswers ExamAnswerBoolean[]
  corrections    ExamCorrection[]

  @@index([userId, examId])
  @@index([examId, status])
  @@map("exam_attempts")
}

// Trả lời cho câu MC (optionId) hoặc ESSAY (textAnswer) — 1 câu hỏi luôn có
// đúng 1 dòng ExamAnswer/attempt. Câu TRUE_FALSE_CLUSTER dùng bảng riêng
// ExamAnswerBoolean bên dưới vì cần 4 câu trả lời độc lập cho 1 câu hỏi.
model ExamAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String? // null = chưa trả lời (MC) hoặc câu ESSAY
  textAnswer String?  @db.Text // chỉ dùng cho câu ESSAY
  answeredAt DateTime @updatedAt

  // Chấm tay câu ESSAY (Giai đoạn 6) — null = chưa chấm, không phải 0 điểm.
  // Không dùng cho MC/CLUSTER (chấm tự động lúc nộp bài).
  pointsAwarded  Float?
  teacherComment String? @db.Text

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   ExamOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@map("exam_answers")
}

// Trả lời cho từng mệnh đề con (subLabel a/b/c/d) của 1 câu TRUE_FALSE_CLUSTER
// — mỗi mệnh đề là 1 dòng riêng vì học sinh đánh đúng/sai độc lập cho từng ý,
// không phải chọn 1 trong 4 như MC (nên không dùng chung ExamAnswer được).
model ExamAnswerBoolean {
  id         String   @id @default(cuid())
  attemptId  String
  optionId   String // ExamOption của mệnh đề con (có subLabel)
  answerTrue Boolean? // null = chưa trả lời ý này
  answeredAt DateTime @updatedAt

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  option  ExamOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, optionId])
  @@map("exam_answer_booleans")
}

// NV-188 — Chữa bài: gợi ý trước, đáp án sau, nhưng có điểm dừng. Một dòng cho mỗi (lượt thi × câu sai).
// Chỉ để HỌC: không bao giờ đụng ExamAttempt.score / ExamAnswer (điểm tính theo lần nộp đầu, lúc nộp bài).
//   tries    — số lần nộp ở màn chữa bài (tối đa 2 có ý nghĩa; lần 2 sai thì hiện đáp án)
//   solved   — đã chọn/điền đúng
//   revealed — đã được xem đáp án (nộp sai lần 2, bấm "Xem đáp án", hoặc câu không có gợi ý sai lần 1)
model ExamCorrection {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  tries      Int      @default(0)
  solved     Boolean  @default(false)
  revealed   Boolean  @default(false)
  lastOptionId String? // MC: lựa chọn của lần nộp gần nhất
  lastText     String? @db.Text // SHORT_ANSWER: câu trả lời của lần nộp gần nhất
  reflection   String? @db.Text // ô không bắt buộc: "gợi ý ở trên giúp bạn ở chỗ nào?"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("exam_corrections")
}

// ─── BÁO CÁO THÁNG GỬI PHỤ HUYNH (NV-185/186/189) ─────────────────────────────
// Một báo cáo = (gia sư × học sinh × tháng), chỉ gồm các môn/lớp của gia sư đó. Số liệu (chuyên cần, nỗ lực,
// năng lực) luôn TÍNH LẠI từ dữ liệu thật khi gia sư mở; bảng này chỉ lưu phần gia sư soạn và phần đã duyệt:
//   draftItems       — các dòng "Điều chưa đạt tháng này" gia sư đang đọc/sửa (KiN chỉ gợi ý sẵn)
//   approvedItems    — bản gia sư đã bấm "Duyệt": phụ huynh trên "Sổ của con" CHỈ thấy bản này
//   approvedSnapshot — số liệu từng môn đóng băng lúc duyệt, để phiếu phụ huynh không đổi sau đó
//   zaloOpenedAt     — gia sư đã MỞ Zalo với tin soạn sẵn (KiN không biết tin có đi thật hay không)
model MonthlyReport {
  id               String    @id @default(cuid())
  tutorId          String
  studentId        String
  yearMonth        String // "YYYY-MM" theo giờ VN
  draftItems       Json?
  approvedItems    Json?
  approvedSnapshot Json?
  approvedAt       DateTime?
  zaloOpenedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tutor   User @relation("ReportTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student User @relation("ReportStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tutorId, studentId, yearMonth])
  @@index([studentId, yearMonth])
  @@map("monthly_reports")
}

// Admin (trung tâm/giáo viên sở hữu đề) gắn cờ này thủ công sau khi xác nhận
// guest đã trả phí qua quy trình sales hiện có (KHÔNG có cổng thanh toán tự
// động — xem plan Giai đoạn 3, reports/2026-07-13.md). Có bản ghi = được thi.
model ExamGuestAccess {
  id        String   @id @default(cuid())
  userId    String
  examId    String
  grantedBy String // userId của admin/giáo viên đã duyệt
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@map("exam_guest_access")
}

// Ngân hàng đề thi — chỉ lưu trữ file đề gốc (PDF/Word) để xem/tải lại sau,
// KHÔNG tự động tách câu khi upload. Tách câu là hành động riêng, chủ động
// (nút "Tách câu hỏi", xem src/app/api/exam-files/[id]/extract/route.ts) —
// tái dùng đúng pipeline AI-extract sẵn có (src/lib/aiExamImport.ts) rồi đưa
// người soạn qua màn hình gán Đầu mục (QuestionCategory) trước khi lưu vào
// Ngân hàng câu hỏi, không tự động lưu thẳng.
model ExamFile {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String // mime type gốc, để biết cách hiển thị/tách
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  // null = "Chưa phân loại". Xoá thư mục KHÔNG xoá theo file (SetNull) — API
  // xoá thư mục vẫn tự chặn nếu còn file để tránh mất tổ chức, xem
  // exam-file-folders/[id]/route.ts.
  folderId String?
  folder   ExamFileFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([folderId])
  @@map("exam_files")
}

// Thư mục Ngân hàng đề thi — 1 CẤP PHẲNG (không thư mục lồng thư mục, khác
// QuestionCategory). Có chủ sở hữu (khác QuestionCategory dùng chung) — mỗi
// giáo viên tự tổ chức file của mình, cùng quy tắc ownerScopeWhere/
// requireOwnedResource như ExamFile.
model ExamFileFolder {
  id        String   @id @default(cuid())
  name      String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  files ExamFile[]

  @@index([ownerId])
  @@map("exam_file_folders")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  phone         String?
  // Số di động ĐÃ XÁC MINH bằng mã SMS (E.164, "+84901234567") — chỉ số này mới đăng nhập được bằng SMS. KHÔNG @unique trên `phone`
  // vì đó là ô tự khai, nhiều người có thể khai cùng một số; unique ở đây vì mỗi số chỉ gắn được với MỘT tài khoản (NULL thì không giới hạn).
  // Đổi `phone` sang số khác thì xoá cả hai cột này (xem src/lib/phoneVerify.ts).
  phoneE164       String?   @unique
  phoneVerifiedAt DateTime?
  dateOfBirth   DateTime? // dùng để tính tuổi tại backend cho ngưỡng xác nhận phụ huynh (D04) — không suy đoán từ input khác
  parentPhone   String? // dữ liệu cũ, tự khai — KHÔNG dùng để cấp quyền; nguồn tin cậy là ParentLink đã verified
  parentName    String? // dữ liệu cũ, tự khai — xem ghi chú parentPhone
  school        String?
  highSchool    String?
  city          String?
  studentId     Int?     @unique
  avatarBase64  String?  @db.Text
  facebookUrl   String?
  zaloPhone     String?
  role          String   @default("student") // "student" | "admin"
  adminRole     String? // "admin_super" | "admin_content" | "teacher"
  emailVerified Boolean  @default(false)
  banned        Boolean  @default(false)
  createdAt     DateTime @default(now())

  // ─── Hồ sơ gia sư (1.4.4) — field phẳng, nhất quán avatarBase64/facebookUrl.
  // Người đăng ký gia sư giữ role "student" cho tới khi admin duyệt (KHÔNG
  // cấp role "admin" ngay — nhiều route coi role "admin" là toàn quyền xem
  // nội dung). Duyệt xong mới thành role "admin" + adminRole "teacher".
  bio               String?   @db.Text
  subjects          String[]  @default([])
  tutorAppliedAt    DateTime? // != null = đã nộp đơn làm gia sư
  // TT-203 + TK-167: lựa chọn giao diện LƯU THEO TÀI KHOẢN (không theo máy). JSON có
  // schema chặt, chỉ đọc/ghi qua src/lib/userPreferences.ts: modules (module gia sư bật
  // thêm ngoài Lịch + Học phí), theme/mode (TK-167), reminders (tắt/bật nhắc từng bên).
  preferences       Json?
  tutorVerified     Boolean   @default(false)
  tutorVerifiedAt   DateTime?
  tutorVerifiedBy   String?   // userId admin đã duyệt
  tutorRejectedAt   DateTime?
  tutorRejectReason String?
  // PH-212: quản trị khoá hồ sơ giả / bị báo cáo → hồ sơ công khai trả 404, gia sư vẫn dùng sổ lớp bình thường.
  profileLockedAt   DateTime?
  profileLockReason String?   @db.Text

  sessionPlans   SessionPlan[]        @relation("SessionPlanTutor")
  profileVisits  ProfileVisit[]       @relation("ProfileVisitTutor")
  profileReports TutorProfileReport[] @relation("ProfileReportTutor")

  ownedCourses        Course[]
  ownedExams          Exam[]
  questionBankItems   QuestionBankItem[]
  examGuestAccess     ExamGuestAccess[]
  examFiles           ExamFile[]
  examFileFolders     ExamFileFolder[]
  ownedAssignments      Assignment[]           @relation("OwnedAssignments")
  assignmentSubmissions AssignmentSubmission[] @relation("AssignmentSubmissions")
  assignmentAnswers     AssignmentAnswer[]     @relation("AssignmentAnswers")
  enrollments         Enrollment[]
  verifyTokens        VerifyToken[]
  passwordResetTokens PasswordResetToken[]
  lessonProgress      LessonProgress[]
  lessonNotes         LessonNote[]
  lessonAzotaDone     LessonAzotaDone[]
  cartItems           CartItem[]
  courseReviews       CourseReview[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  examResults         ExamResult[]
  examAttempts        ExamAttempt[]
  badges              UserBadge[]
  threads             Thread[]
  threadReplies       ThreadReply[]
  threadLikes         ThreadLike[]
  replyLikes          ReplyLike[]
  threadBookmarks     ThreadBookmark[]
  wallet              Wallet?
  coinTransactions    CoinTransaction[]
  questions           Question[]
  answers             Answer[]
  answerReports       AnswerReport[]
  threadReports       ThreadReport[]
  tutorSubscriptions  TutorSubscription[]
  monthlyReportsAsTutor   MonthlyReport[] @relation("ReportTutor")
  monthlyReportsAsStudent MonthlyReport[] @relation("ReportStudent")
  absencesAsStudent    ClassAbsence[]      @relation("AbsenceStudent")
  makeupCredits        MakeupCredit[]      @relation("MakeupStudent")
  reminderLogsStudent  ClassReminderLog[]  @relation("ReminderStudent")
  reminderLogsTutor    ClassReminderLog[]  @relation("ReminderTutor")
  parentLinksAsParent  ParentLink[] @relation("ParentLinks")
  parentLinksAsStudent ParentLink[] @relation("StudentLinks")
  auditLogs            AuditLog[]
  createdClassInvites  ClassInvite[] @relation("ClassInviteCreator")
  topupRequests        CoinTopupRequest[] @relation("TopupRequests")
  topupReviews         CoinTopupRequest[] @relation("TopupRequestReviews")
  monthlyCourseFeesUpdated MonthlyCourseFee[] @relation("MonthlyCourseFeeUpdater")
  tuitionOverride      TuitionOverride?   @relation("TuitionOverrideUser")
  tuitionOverridesUpdated TuitionOverride[] @relation("TuitionOverrideUpdater")
  attendanceSessions   AttendanceSession[] @relation("AttendanceSessionCreator")
  attendanceRecords    AttendanceRecord[]  @relation("AttendanceRecordStudent")
  payoutAccount        TutorPayoutAccount? @relation("PayoutAccountUser")
  invoicesIssued       TuitionInvoice[]    @relation("InvoiceTutor")
  invoicesReceived     TuitionInvoice[]    @relation("InvoiceStudent")
  bankTransactions     BankTransaction[]   @relation("BankTxTutor")
  tuitionCredits       TuitionCredit[]     @relation("CreditTutor")
  tuitionCreditsOwned  TuitionCredit[]     @relation("CreditStudent")

  @@map("users")
}

// ─── TUTOR VIP SUBSCRIPTION ──────────────────────────────────────────────────
// Mô hình SaaS (D01 chốt 05/10/2026): gia sư trả phí VIP để mở full tính
// năng. 3 gói cố định (tháng / 6 tháng / 1 năm). Không phải "gói học viên
// mua lớp" như backlog BE-055 gốc. Học viên vẫn free trong giai đoạn này.
//
// Lưu lịch sử: mỗi lần mua tạo 1 bản ghi mới (không update bản cũ) — cho
// phép đối soát doanh thu và xem lịch sử nâng cấp của gia sư. Mua khi đang
// VIP: bản ghi mới nối tiếp (startDate = endDate gói trước).

model TutorSubscription {
  id              String   @id @default(cuid())
  userId          String   // gia sư mua gói
  planCode        String   // "monthly" | "half_year" | "yearly" (xem TUTOR_VIP_PLANS trong src/lib/tutorSubscription.ts)
  priceCoinPaid   Int      // snapshot giá tại thời điểm mua (có thể khác giá hiện tại nếu admin đổi sau)
  durationDays    Int      // snapshot thời hạn (30/180/365)
  startDate       DateTime @default(now()) // có thể ở tương lai nếu mua nối tiếp
  endDate         DateTime // startDate + durationDays — tính sẵn để query "còn hạn" chỉ cần 1 cột
  status          String   @default("active") // "active" | "expired" | "cancelled"
  // Note: Không có renewalFrom vì D10 (gia hạn tự động) đang HOÃN — mỗi lần
  // gia hạn hiện tại = mua gói mới hoàn toàn. Khi mở auto-renew sau, thêm
  // renewalFromId: String? trỏ về bản ghi gốc.
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, endDate])
  @@map("tutor_subscriptions")
}

model VerifyToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verify_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── ENROLLMENTS ──────────────────────────────────────────────────────────────

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  // Trạng thái của việc ghi danh. Mọi query coi "đã ghi danh" dùng để mở
  // quyền xem/làm bài phải lọc status = "active".
  //   - "pending_consent" : đang chờ phụ huynh xác nhận (học viên dưới ngưỡng
  //                          tuổi D04). Không có quyền học, nhưng hồ sơ giữ
  //                          nguyên để khi phụ huynh duyệt là bật ngay.
  //   - "active"          : đang học bình thường (mặc định)
  //   - "suspended"       : đã hết hạn gói hoặc bị tạm dừng — vẫn xem lại được
  //                          nội dung cũ nhưng không có hoạt động mới (R01).
  status String @default("active")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  parentConsent ParentConsent?

  @@unique([userId, courseId])
  @@index([status])
  @@map("enrollments")
}

// ─── TUITION (AS-192 + AS-193, chốt 06/10/2026) ───────────────────────────────
// Học phí tính THEO THÁNG, không theo buổi có mặt. Spec:
// docs/kin/quyet-dinh-giao-dien-va-hoc-phi.md mục 3.
//
// Công thức:
//   Đơn giá/buổi = tier theo tổng số môn em đăng ký (1 môn 70k, 2 môn 60k,
//                   3 môn 55k, 4 môn 50k) — có thể override per-user.
//   Học phí gốc  = Σ theo môn: (sessionCount − freeCount) × đơn giá
//   Phải đóng    = gốc − học bổng − giảm trừ (sàn 0)
//
// Vắng KHÔNG trừ tiền (D01). Attendance (AS-191) dùng cho chuyên cần, không
// cho học phí.

model MonthlyCourseFee {
  id           String   @id @default(cuid())
  courseId     String
  yearMonth    String // "YYYY-MM" — tránh timezone + dễ query
  sessionCount Int // số buổi của môn/lớp này trong tháng
  freeCount    Int      @default(0) // số buổi miễn phí (trial, bù)
  updatedBy    String // userId gia sư cập nhật
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  updater User   @relation("MonthlyCourseFeeUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@unique([courseId, yearMonth])
  @@index([yearMonth])
  @@map("monthly_course_fees")
}

// Override đơn giá/buổi cho 1 học viên — bỏ qua tier bậc thang. VD HS khó
// khăn được giảm xuống 40k/buổi dù đăng ký 2 môn (vẫn 60k theo tier). Set
// null hoặc xoá bản ghi để quay về tier.
model TuitionOverride {
  id              String   @id @default(cuid())
  userId          String   @unique
  pricePerSession Int
  note            String?  @db.Text
  updatedBy       String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  user    User @relation("TuitionOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  updater User @relation("TuitionOverrideUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@map("tuition_overrides")
}

// ─── ATTENDANCE (AS-191, chốt 06/10/2026) ─────────────────────────────────────
// Điểm danh theo buổi. 5 trạng thái:
//   "present"  → hệ số 1    (có mặt)
//   "late"     → hệ số 0.9  (muộn, GD-05)
//   "excused"  → hệ số 0.8  (nghỉ có phép)
//   "absent"   → hệ số 0.5  (vắng không phép)
//   (không có record)       → không tính (GD-06 "chưa điểm danh")
//
// Hệ số áp dụng cho CHUYÊN CẦN (NV-186), KHÔNG trừ học phí (D01 chốt
// "vắng không trừ tiền" — mục 3 trong quyet-dinh-giao-dien-va-hoc-phi.md:
// buổi nào cũng có bản ghi để xem lại).

model AttendanceSession {
  id         String   @id @default(cuid())
  courseId   String
  date       DateTime // ngày buổi học — unique với courseId để tránh trùng
  note       String?  @db.Text
  createdBy  String   // gia sư tạo (userId)
  createdAt  DateTime @default(now())

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator  User                @relation("AttendanceSessionCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  records  AttendanceRecord[]

  @@unique([courseId, date])
  @@index([courseId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String   // học viên
  status     String   // "present" | "late" | "excused" | "absent"
  note       String?  @db.Text
  updatedBy  String?  // userId gia sư cập nhật lần cuối
  // TT-199: gia sư ĐÃ MỞ Zalo để nhắn phụ huynh về buổi này. Đổi trạng thái điểm danh thì xoá mốc
  // (tin cũ nói về trạng thái cũ). KiN không biết tin có đi thật hay không.
  zaloOpenedAt DateTime?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User              @relation("AttendanceRecordStudent", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("attendance_records")
}

// ─── BÁO NGHỈ SÁT GIỜ, BUỔI BÙ, NHẮC LỊCH (TT-201/202/203) ───────────────────
// Quy tắc: docs/kin/nghiep-vu/lich-nhac-va-che-do-gon.md. Buổi học KHÔNG có bản ghi
// riêng (ClassSchedule là quy luật lặp hàng tuần), nên một buổi được định danh bằng
// (scheduleId, dateKey) với dateKey = "YYYY-MM-DD" theo giờ Việt Nam.

// Một lần phụ huynh báo con nghỉ một buổi cụ thể.
//   excused_auto — báo trước ≥ 2 giờ: tự ghi "Nghỉ có báo", tự giữ 1 buổi bù
//   pending      — báo dưới 2 giờ: chờ gia sư bấm 1 nút (hiện ở Hộp việc / chấm trên Lịch)
//   excused_free — gia sư chọn "Không tính phí, giữ 1 buổi bù"
//   charged      — gia sư chọn "Tính phí buổi này" (không có buổi bù)
//   voided       — gia sư HUỶ buổi khi báo nghỉ còn "pending": buổi không diễn ra nên không tính phí, không buổi bù
model ClassAbsence {
  id          String    @id @default(cuid())
  courseId    String
  scheduleId  String // ClassSchedule.id — không FK: xoá khung giờ không được xoá lịch sử báo nghỉ
  dateKey     String // "YYYY-MM-DD" giờ VN
  startAt     DateTime // thời điểm bắt đầu buổi, chốt lúc báo (đổi lịch sau không làm lệch lịch sử)
  studentId   String
  reportedBy  String // "parent" | "student"
  reportedAt  DateTime  @default(now())
  leadMinutes Int // số phút báo trước giờ học
  reason      String?   @db.Text
  status      String
  resolvedAt  DateTime?
  resolvedBy  String? // userId gia sư xử lý (null với excused_auto)
  createdAt   DateTime  @default(now())

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User          @relation("AbsenceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  makeup  MakeupCredit?

  @@unique([scheduleId, dateKey, studentId])
  @@index([courseId, status])
  @@index([studentId])
  @@map("class_absences")
}

// Buổi bù: sinh ra cùng lúc với một ClassAbsence miễn phí (đúng 1 buổi bù cho 1 lần nghỉ,
// ép bằng absenceId @unique). Hết hạn sau 30 ngày; "hết hạn" suy ra từ expiresAt chứ không
// có cron đổi trạng thái. Dùng khi gia sư điểm danh một buổi mới (usedSessionId).
model MakeupCredit {
  id            String    @id @default(cuid())
  studentId     String
  courseId      String
  absenceId     String    @unique
  grantedAt     DateTime  @default(now())
  expiresAt     DateTime
  status        String    @default("active") // "active" | "used"
  usedAt        DateTime?
  usedSessionId String?

  student User         @relation("MakeupStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  absence ClassAbsence @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([courseId, status, expiresAt])
  @@map("makeup_credits")
}

// Nhật ký "Đã mở Zalo lúc …" (TT-199 giai đoạn 1): KiN chỉ biết gia sư đã MỞ Zalo với tin
// soạn sẵn, không biết tin đã đi thật hay chưa nên không bao giờ ghi "đã gửi". Mỗi
// (buổi × học sinh × bên nhận × loại tin) tối đa một dòng ⇒ tối đa 2 tin nhắc cho mỗi bên,
// mỗi buổi.
model ClassReminderLog {
  id         String   @id @default(cuid())
  courseId   String
  scheduleId String
  dateKey    String
  studentId  String
  recipient  String // "parent" | "student"
  kind       String // "h24" | "h1"
  tutorId    String
  openedAt   DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation("ReminderStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   User   @relation("ReminderTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dateKey, studentId, recipient, kind])
  @@index([courseId, dateKey])
  @@map("class_reminder_logs")
}

// ─── PHIẾU HỌC PHÍ + ĐỐI SOÁT VIETQR (TT-200) ────────────────────────────────
// Nguyên tắc (docs/kin/nghiep-vu/doi-soat-vietqr.md): tiền đi THẲNG vào tài
// khoản của gia sư — KiN không giữ, không thu hộ, không cắt phần trăm. KiN chỉ
// ĐỌC tiền vào qua dịch vụ trung gian (SePay) do gia sư tự mở, và chỉ tự gạch
// phiếu khi chắc chắn (đúng mã + đúng số tiền còn lại). Không bao giờ tự ghép
// theo số tiền (GD-20). Không lưu số dư tài khoản của gia sư (GD-22).

// Tài khoản nhận học phí của gia sư + khoá webhook. Khoá lưu BĂM (sha256), chỉ
// hiện bản rõ đúng 1 lần lúc tạo/đổi — lộ DB cũng không làm giả được webhook.
model TutorPayoutAccount {
  userId         String    @id
  bankBin        String // BIN VietQR 6 số, vd "970436"
  accountNo      String
  accountName    String // IN HOA không dấu, đúng tên chủ tài khoản
  webhookKeyHash String? // sha256 hex của khoá SePay gửi kèm (Authorization: Apikey …)
  webhookKeyHint String? // 4 ký tự cuối để gia sư nhận ra khoá nào
  webhookSeenAt  DateTime? // lúc nhận giao dịch đầu tiên → "Đang nối SePay"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation("PayoutAccountUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_payout_accounts")
}

// Phiếu học phí của 1 em trong 1 tháng. `code` KHÔNG ĐỔI kể cả khi sửa số tiền
// (GD-19). `amountDue` là số tiền CHỐT lúc lập (quy tắc tiền chốt vào sự kiện):
// gia sư tăng giá sau đó thì phiếu cũ giữ nguyên.
//   draft → sent → parent_reported → partial → paid ;  bất kỳ lúc nào → cancelled
model TuitionInvoice {
  id               String    @id @default(cuid())
  code             String    @unique // "KIN" + 5 ký tự A–Z/2–9 bỏ O I L
  tutorId          String
  studentId        String
  yearMonth        String // "YYYY-MM"
  amountDue        Int // VND, không làm tròn
  paidAmount       Int       @default(0)
  status           String    @default("draft") // draft | sent | parent_reported | partial | paid | cancelled
  breakdown        Json? // ảnh chụp computeMonthlyFee + tín dụng đã trừ, để in lại đúng
  cancelReason     String?   @db.Text
  sentAt           DateTime?
  parentReportedAt DateTime?
  paidAt           DateTime?
  // TT-199 giai đoạn 1: link riêng xem phiếu không cần tài khoản (hết hạn 60 ngày, GD-28).
  // KHÔNG @unique (xem ghi chú ở ParentLink.portalToken: db push trên cột cũ).
  viewToken          String?
  viewTokenExpiresAt DateTime?
  zaloOpenedAt       DateTime? // gia sư ĐÃ MỞ Zalo — KiN không biết tin có đi thật hay không
  parentViewedAt     DateTime? // phụ huynh mở link (ghi từ trình duyệt, không phải khi bot xem trước link)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tutor   User @relation("InvoiceTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student User @relation("InvoiceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([tutorId, studentId, yearMonth])
  @@index([tutorId, yearMonth])
  @@index([studentId])
  @@index([viewToken])
  @@map("tuition_invoices")
}

// Mỗi khoản tiền vào (SePay hoặc gia sư tự ghi tiền mặt) là 1 dòng — có dấu vết
// ai bấm, lúc nào. Chống trùng: (tutorId, provider, providerTxId) là duy nhất.
//   kind   : exact | short | over | already_paid | cancelled | unknown_code | no_code
//   status : matched (tự gạch) | pending (chờ gia sư) | resolved (gia sư đã xử lý) | ignored
model BankTransaction {
  id                  String    @id @default(cuid())
  tutorId             String
  provider            String    @default("sepay") // "sepay" | "manual"
  providerTxId        String
  occurredAt          DateTime
  amount              Int
  content             String    @db.Text
  providerCode        String? // trường `code` SePay đã tách sẵn
  referenceCode       String?
  gateway             String?
  matchedCode         String? // mã KIN tìm được trong code/content
  invoiceId           String?
  appliedAmount       Int       @default(0) // phần đã cộng vào phiếu
  kind                String
  status              String
  resolution          String? // auto_matched | applied_partial | credit_next_month | refunded | matched_manual | manual_cash | not_tuition
  resolvedBy          String?
  resolvedAt          DateTime?
  suggestedInvoiceIds String[]  @default([]) // gợi ý cùng số tiền — KHÔNG tự ghép
  // HP-20 (23/10/2026): hình thức khi gia sư tự ghi tay: "cash" | "bank_transfer". null = bản ghi cũ (coi là tiền mặt) hoặc
  // tiền vào qua SePay. Ngày thu của khoản ghi tay chính là `occurredAt` (báo cáo doanh thu đã tính theo cột này).
  method              String?
  createdAt           DateTime  @default(now())

  tutor   User            @relation("BankTxTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  invoice TuitionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([tutorId, provider, providerTxId])
  @@index([tutorId, status])
  @@index([invoiceId])
  @@map("bank_transactions")
}

// Tiền đóng dư gia sư chọn "Trừ vào tháng sau". Lập phiếu tháng kế tiếp tự trừ
// theo thứ tự cũ → mới và ghi vào breakdown của phiếu.
model TuitionCredit {
  id         String    @id @default(cuid())
  tutorId    String
  studentId  String
  amount     Int // số tiền dư ban đầu
  usedAmount Int       @default(0)
  sourceTxId String?
  createdAt  DateTime  @default(now())

  tutor   User @relation("CreditTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student User @relation("CreditStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tutorId, studentId])
  @@map("tuition_credits")
}

// HP-21 (23/10/2026): nhật ký hoàn tác một khoản đã thu. BẢNG MỚI, chỉ thêm dòng, không sửa/xoá dòng cũ. Một khoản tiền có thể
// bị hoàn tác nhiều lần (ghép sai → hoàn tác → ghép lại → hoàn tác) nên không đặt cột hoàn tác trên BankTransaction.
// Không khoá ngoại tới người dùng (tránh đụng model User); tutorId/bankTransactionId/invoiceId chỉ để tra cứu.
//   outcome: "requeued" (khoản tiền thật đã vào TK gia sư → quay lại hàng chờ đối soát)
//            "voided"   (khoản gia sư tự ghi tay → coi như ghi nhầm, loại khỏi doanh thu)
model PaymentReversal {
  id                String   @id @default(cuid())
  tutorId           String
  bankTransactionId String
  invoiceId         String
  reversedAmount    Int // phần đã cộng vào phiếu nay được trừ ra
  reason            String   @db.Text
  outcome           String
  invoiceStatusFrom String
  invoiceStatusTo   String
  creditsVoided     Int      @default(0) // tổng tiền dư (tín dụng tháng sau) được thu hồi
  reversedBy        String
  createdAt         DateTime @default(now())

  @@index([tutorId, createdAt])
  @@index([bankTransactionId])
  @@index([invoiceId])
  @@map("payment_reversals")
}

// ─── HỌC PHÍ KIỂU MỚI (HP-14..HP-17, 23/10/2026) ──────────────────────────────────────────────────────────────
// Chỉ lớp có Course.feeMode khác "monthly_sessions" dùng các bảng này. Lớp cũ không có dòng nào ở đây và phiếu của lớp cũ
// KHÔNG đổi một đồng. Bảng MỚI; không khoá ngoại tới User (tránh đụng model User), chỉ khoá tới Course (xoá lớp thì xoá theo).
// Quy tắc "tiền chốt vào sự kiện": FeeCharge lưu số tiền đã tính ngay lúc điểm danh; khi vào phiếu (invoiceId) thì ĐÓNG BĂNG.

// Lịch sử đơn giá của lớp. Đơn giá áp cho buổi có ngày >= effectiveFrom (ngày VN, "YYYY-MM-DD"); buổi trước đơn giá đầu tiên dùng đơn giá đầu tiên.
//   per_session: rate = đ / buổi ; per_hour: rate = đ / giờ + sessionMinutes ; per_course: rate = đ / khoá / học sinh.
model CourseFeeRate {
  id             String   @id @default(cuid())
  courseId       String
  mode           String
  rate           Int
  sessionMinutes Int? // chỉ per_hour: một buổi dài bao nhiêu phút
  effectiveFrom  String
  note           String?  @db.Text
  createdBy      String
  createdAt      DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, effectiveFrom])
  @@index([courseId])
  @@map("course_fee_rates")
}

// HP-17: đơn giá riêng cho một cặp (học sinh, lớp). Cùng đơn vị với đơn giá lớp (đ/buổi, đ/giờ hoặc đ/khoá). Có hiệu lực từ ngày.
// Không dùng TuitionOverride (đó là giá theo em TOÀN CỤC của cách tính cũ, giữ nguyên).
model CourseStudentRate {
  id            String   @id @default(cuid())
  courseId      String
  studentId     String
  rate          Int
  effectiveFrom String
  note          String?  @db.Text
  createdBy     String
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, effectiveFrom])
  @@index([courseId, studentId])
  @@map("course_student_rates")
}

// Một dòng phí đã tính. kind: "session" (một buổi, gắn recordId) | "course" (cả khoá, một lần) | "extra" (phí khác, HP-18).
// invoiceId null = chưa vào phiếu nào (còn sửa được: đổi đơn giá, đổi trạng thái điểm danh). Đã vào phiếu = đóng băng.
model FeeCharge {
  id         String   @id @default(cuid())
  tutorId    String
  courseId   String
  studentId  String
  kind       String
  recordId   String? // AttendanceRecord.id cho kind=session. Nullable nên @unique cho phép nhiều dòng không có recordId.
  dateKey    String // ngày VN của buổi / ngày phát sinh
  yearMonth  String // tháng của dateKey — phiếu tháng đó gom dòng này
  amount     Int // đồng, đã làm tròn từng dòng
  units      Int? // per_hour: số phút của buổi
  rate       Int? // đơn giá đã áp
  rateSource String   @default("class") // "class" | "student"
  mode       String
  label      String? // kind=extra: tên khoản (tài liệu, quỹ lớp…)
  invoiceId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([recordId])
  @@index([tutorId, studentId, yearMonth])
  @@index([courseId, dateKey])
  @@index([invoiceId])
  @@map("fee_charges")
}

// ─── COIN TOPUP REQUEST (FE-128) ──────────────────────────────────────────────
// User yêu cầu nạp Coin (chủ yếu gia sư nạp để mua VIP, D01 chốt). Chuyển
// khoản ngân hàng thủ công — admin đối chiếu rồi approve, hệ thống cộng
// Coin vào Wallet + ghi CoinTransaction.
//
// Không gộp vào CoinTransaction vì:
//  - CoinTransaction là ghi sổ sau khi đã cộng/trừ xong (ăn khớp balance).
//  - Topup có 3 trạng thái: pending (chưa cộng), approved (đã cộng + có
//    CoinTransaction), rejected (không cộng, giữ bản ghi để tra cứu).
model CoinTopupRequest {
  id          String    @id @default(cuid())
  userId      String
  amountVnd   Int // số VND user báo đã chuyển
  coinAmount  Int // số Coin cộng khi approve (1 Coin = 1 VND trong giai đoạn này)
  status      String    @default("pending") // "pending" | "approved" | "rejected"
  bankRef     String? // mã giao dịch người dùng khai báo (nếu có)
  note        String?   @db.Text // ghi chú user khai
  rejectReason String?  @db.Text
  reviewedBy  String? // admin userId
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  user     User  @relation("TopupRequests",      fields: [userId],     references: [id], onDelete: Cascade)
  reviewer User? @relation("TopupRequestReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("coin_topup_requests")
}

// ─── CLASS INVITE (BE-063 — 1.4.6) ────────────────────────────────────────────
// Mã mời vào lớp do gia sư tạo. Dùng để học viên tự redeem (nhập tay hoặc theo
// link) thay vì admin phải gán từng người. Khác ParentConsent.token (32 byte
// hex, 1 lần dùng): ClassInvite.code là mã rút gọn 8 ký tự base32 (loại trừ
// 0/1/I/O cho dễ đọc/gõ), có thể dùng nhiều lần tới `maxUses` và/hoặc tới
// `expiresAt`.
//
// `revoked = true` giữ bản ghi để lịch sử — không xoá hẳn (BE-066).
model ClassInvite {
  id         String    @id @default(cuid())
  courseId   String
  code       String    @unique
  maxUses    Int? // null = không giới hạn
  usedCount  Int       @default(0)
  expiresAt  DateTime? // null = không hết hạn
  revoked    Boolean   @default(false)
  createdBy  String
  createdAt  DateTime  @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator User   @relation("ClassInviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("class_invites")
}

// ─── PARENT LINKS & CONSENT ───────────────────────────────────────────────────
// Xác thực quan hệ phụ huynh–học viên (G1.04) và ghi nhận đồng ý khi học viên
// dưới ngưỡng tuổi tham gia lớp (G2.07–G2.11, D04). User.parentPhone/parentName
// là dữ liệu cũ tự khai, KHÔNG được dùng làm nguồn cấp quyền — chỉ ParentLink
// có status "verified" mới được coi là quan hệ phụ huynh hợp lệ.
// Xem files/07_ke_hoach_chuyen_doi_gia_su.md mục 3.3 để biết bối cảnh.

model ParentLink {
  id         String    @id @default(cuid())
  parentId   String
  studentId  String
  status     String    @default("pending") // "pending" | "verified" | "revoked"
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  // TK-178 (09/10/2026): token xem "Sổ của con" không cần đăng nhập, cho
  // phụ huynh chưa đăng ký tài khoản xem báo cáo của con. Token sinh 1 lần
  // (gia sư copy link gửi Zalo), có thể revoke bằng cách set NULL. Chỉ bật
  // khi status = "verified". KHÔNG có hạn tự động — gia sư chủ động revoke
  // khi em nghỉ lớp, tránh phụ huynh phàn nàn "sao hết link rồi".
  //
  // KHÔNG @unique: Prisma coi việc thêm UNIQUE lên cột cũ là "data loss"
  // nên db push yêu cầu --accept-data-loss, kẹt production build. Entropy
  // 128 bit từ generatePortalToken (16 bytes random) đã đủ chống trùng
  // trong thực tế. @@index để query token nhanh.
  portalToken String?

  parent  User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  consents ParentConsent[]

  @@unique([parentId, studentId])
  @@index([studentId])
  @@index([portalToken])
  @@map("parent_links")
}

// 1 bản ghi đồng ý cho 1 lần enrollment cụ thể cần xác nhận (học viên dưới
// ngưỡng tuổi). Token dùng 1 lần, có hạn — không được tái sử dụng sau khi đã
// approved/rejected/expired (G2.08, G2.11).
model ParentConsent {
  id             String    @id @default(cuid())
  parentLinkId   String
  enrollmentId   String?   @unique
  token          String    @unique
  status         String    @default("pending") // "pending" | "approved" | "rejected" | "expired"
  contentVersion String // phiên bản nội dung xác nhận đã hiển thị cho phụ huynh, để đối chiếu khi có tranh chấp
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())

  parentLink ParentLink  @relation(fields: [parentLinkId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([parentLinkId])
  @@map("parent_consents")
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────
// Nhật ký các hành động đổi quyền/đồng ý có ảnh hưởng tới người khác (G1.13,
// P0). Bắt đầu từ ParentLink/ParentConsent (verify/revoke/approve/reject) —
// đổi quyền, điểm, Coin sẽ nối dần vào các luồng liên quan sau, dùng chung
// action namespace dạng "resource.event" (vd "parent_link.verify").
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String? // null nếu hệ thống tự thực hiện (vd hết hạn tự động)
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@map("audit_logs")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "enrollment" | "exam_new" | "exam_reminder" | "thread_reply" | "thread_like" | "reply_like" | "article_new" | "parent_link_request" | "parent_link_verified" | "parent_consent_requested" | "parent_consent_responded"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  count     Int      @default(1) // số lượt gộp — vd "X và 4 người khác đã thích..."
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── THÔNG BÁO ĐẨY (ĐX-02) ────────────────────────────────────────────────────
// Mỗi dòng là MỘT trình duyệt / thiết bị của gia sư đã bật "Thông báo đẩy". `endpoint` + `p256dh` + `auth` là thứ trình duyệt cấp
// (khoá công khai của thiết bị, không phải bí mật của tài khoản). `endpoint` unique: một thiết bị đổi tài khoản thì dòng chuyển sang người mới.
// `revokedAt` đặt khi dịch vụ đẩy trả 404/410 (thiết bị đã gỡ quyền) — không gửi nữa; người dùng bấm tắt / gỡ thì XOÁ hẳn dòng.
// Chữ gửi đi dựng từ LOẠI thông báo (src/lib/pushRules.ts), không đọc từ bảng notifications.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("push_subscriptions")
}

// ─── LESSON PROGRESS ──────────────────────────────────────────────────────────

model LessonProgress {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  completedAt    DateTime @default(now())
  watchedSeconds Int      @default(0)
  // true = đã xong; false = đang xem dở (chỉ lưu giây xem). Hàng cũ mặc định true (trước đây hàng nào có mặt cũng bị coi là "xong").
  completed      Boolean  @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ─── FILE ASSETS ──────────────────────────────────────────────────────────────
// Tệp gia sư tải lên KiN (hiện là VIDEO bài giảng; tài liệu sẽ ghi bytes ở đây khi cần, MD-08). Chỉ THÊM.
// Không có địa chỉ công khai: phát qua /api/media/[id]/stream sau khi kiểm quyền (src/lib/lessonGuard.ts canWatchStoredMedia).
// Bài giảng tham chiếu bằng "kin-media:<id>" trong Lesson.videoUrl.
model FileAsset {
  id           String   @id @default(cuid())
  ownerId      String // gia sư tải lên
  courseId     String // lớp chứa bài
  lessonId     String? // gắn khi lưu bài
  kind         String   @default("video") // "video" | "document"
  driver       String // "local" | "cloudinary"
  storageKey   String // đường dẫn trong kho (local: tên tệp; cloudinary: public_id)
  mimeType     String
  bytes        Int? // null khi chưa tải xong
  originalName String
  status       String   @default("pending") // "pending" | "ready"
  createdAt    DateTime @default(now())

  @@index([ownerId])
  @@index([courseId])
  @@index([lessonId])
  @@map("file_assets")
}

// ─── AZOTA: HỌC SINH BÁO "ĐÃ LÀM" ─────────────────────────────────────────────
// Lời khai của học sinh rằng đã làm bài Azota của một bài giảng (KiN không biết thật), kèm LINK bài làm (không bắt buộc).
// Bảng riêng, KHÔNG dùng Assignment: tránh bài "ảo" lọt vào danh sách bài tập, hàng đợi chấm và số "chưa chấm" của gia sư.
// Không có trường ảnh: KiN không nhận ảnh bài làm của học sinh dưới 16 tuổi. Chỉ THÊM.
model LessonAzotaDone {
  id       String   @id @default(cuid())
  lessonId String
  userId   String
  kind     String   @default("done") // "done" (chỉ bấm Em đã làm xong) | "link" (kèm link bài làm trên azota.vn)
  linkUrl  String?
  doneAt   DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([lessonId])
  @@map("lesson_azota_done")
}

// ─── LESSON NOTES ─────────────────────────────────────────────────────────────
// Ghi chú cá nhân của học sinh cho từng bài học — trước đây lưu localStorage
// nên không đồng bộ giữa các thiết bị (mobile/web riêng), giờ lưu DB thật.

model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  text      String   @db.Text
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_notes")
}

// ─── EXAM RESULTS ─────────────────────────────────────────────────────────────

model ExamResult {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  score       Float
  totalPoints Int      @default(150)
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@map("exam_results")
}

// ─── BADGES ───────────────────────────────────────────────────────────────────

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── COMMUNITY ────────────────────────────────────────────────────────────────

model Thread {
  id        String    @id @default(cuid())
  content   String    @db.Text
  authorId  String
  category  String    @default("hoi-dap")
  isPinned  Boolean   @default(false)
  imageUrls String[]
  fileUrl   String?
  fileName  String?
  deletedAt DateTime? // soft-delete — xoá thật để lại dấu vết, tránh mất bằng chứng khi có tranh chấp
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Phạm vi bài viết: null = "cộng đồng chung" cho mọi học viên (giữ hành vi
  // cũ cho bài trước thời điểm triển khai 1.4.7); có courseId = thread riêng
  // của lớp đó, chỉ members của lớp (học viên Enrollment.active + GVCN
  // Course.ownerId) được post và xem (sẽ enforce ở route — xem BE-071).
  // onDelete SetNull: khi xoá lớp, bài viết chuyển về "cộng đồng chung" chứ
  // không mất dấu vết.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ThreadReply[]
  likes     ThreadLike[]
  bookmarks ThreadBookmark[]
  reports   ThreadReport[]

  @@index([courseId])
  @@map("threads")
}

model ThreadReport {
  id         String   @id @default(cuid())
  threadId   String
  reporterId String
  reason     String
  status     String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt  DateTime @default(now())

  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([threadId, reporterId])
  @@map("thread_reports")
}

model ThreadReply {
  id        String    @id @default(cuid())
  content   String    @db.Text
  authorId  String
  threadId  String
  imageUrls String[]
  deletedAt DateTime? // soft-delete, xem giải thích ở Thread.deletedAt
  createdAt DateTime  @default(now())

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  thread Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  likes  ReplyLike[]

  @@map("thread_replies")
}

model ThreadLike {
  userId   String
  threadId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([userId, threadId])
  @@map("thread_likes")
}

model ReplyLike {
  userId  String
  replyId String

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply ThreadReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@id([userId, replyId])
  @@map("reply_likes")
}

model ThreadBookmark {
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([userId, threadId])
  @@map("thread_bookmarks")
}

// ─── COIN ECONOMY & HỎI ĐÁP (Knowledge Bounty) ────────────────────────────────
// Đặt câu hỏi mất xu (phí cố định), trả lời được chấp nhận nhận xu thưởng
// (hệ thống cấp riêng, không lấy từ phí người hỏi). Report sai/spam do admin
// duyệt — nếu đúng, trừ lại xu thưởng đã nhận.

model Wallet {
  userId  String @id
  balance Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // dương = cộng, âm = trừ
  reason    String // mã nghiệp vụ cụ thể — xem COIN_REASONS trong src/lib/wallet-constants.ts
  refId     String? // id câu hỏi/trả lời liên quan (để truy vết)
  // Phân loại nguồn dòng tiền ở cấp cao hơn `reason` — dùng cho báo cáo doanh
  // thu và lọc lịch sử theo lớp. Giá trị: "topup" | "reward" |
  // "class_subscription" | "refund" | "penalty". Nullable vì bản ghi cũ chưa
  // có — tuyệt đối không suy đoán ngược từ reason (xem BE-039).
  sourceType String?
  // Lớp liên quan — gắn khi sourceType = "class_subscription" (phí mua gói),
  // hoặc các giao dịch được quy về lớp (hoàn/phạt theo lớp). Nullable cho các
  // giao dịch không gắn lớp như signup_bonus/thread_reward.
  classId    String?
  createdAt  DateTime @default(now())

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Course? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([classId])
  @@index([sourceType])
  @@map("coin_transactions")
}

model Question {
  id               String   @id @default(cuid())
  authorId         String
  title            String
  content          String   @db.Text
  bountyPaid       Int // số xu đã trừ khi đăng (lưu lại để minh bạch)
  status           String   @default("open") // "open" | "answered"
  acceptedAnswerId String?  @unique
  createdAt        DateTime @default(now())

  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers        Answer[] @relation("QuestionAnswers")
  acceptedAnswer Answer?  @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id])

  @@map("questions")
}

model Answer {
  id          String   @id @default(cuid())
  questionId  String
  authorId    String
  content     String   @db.Text
  rewardPaid  Int? // số xu đã thưởng (null nếu chưa được chấp nhận)
  isPenalized Boolean  @default(false) // đã bị admin duyệt report và trừ xu
  createdAt   DateTime @default(now())

  question    Question       @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  acceptedFor Question?      @relation("AcceptedAnswer")
  reports     AnswerReport[]

  @@map("answers")
}

model AnswerReport {
  id         String   @id @default(cuid())
  answerId   String
  reporterId String
  reason     String
  status     String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt  DateTime @default(now())

  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([answerId, reporterId])
  @@map("answer_reports")
}

// ─── NEWS / ARTICLES ──────────────────────────────────────────────────────────

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  content     String    @db.Text
  category    String
  author      String
  authorId    String
  tag         String?
  isPinned    Boolean   @default(false)
  published   Boolean   @default(false)
  readTime    Int       @default(5)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("articles")
}

// ─── PHỄU GIA SƯ (PH-207..212, đặc tả pheu-gia-su.md) ─────────────────────────
// Mỗi lượt mở link hồ sơ công khai ghi 1 dòng theo đuôi ?n= (kênh). Không đếm được bài đăng trong nhóm Facebook,
// chỉ đếm lượt bấm link. visitorKey là mã NGẪU NHIÊN theo phiên trình duyệt, chỉ để không đếm trùng — không phải định danh người.
//   kind: "open" (mở link) | "full" (kéo tới cuối hồ sơ)
model ProfileVisit {
  id         String   @id @default(cuid())
  tutorId    String
  channel    String
  kind       String
  visitorKey String
  createdAt  DateTime @default(now())

  tutor User @relation("ProfileVisitTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, channel, kind, visitorKey])
  @@index([tutorId, createdAt])
  @@index([channel, createdAt])
  @@map("profile_visits")
}

// Báo cáo hồ sơ gia sư (chống lừa đảo). Ai cũng gửi được, không cần tài khoản.
//   reason: "thu-phi-truoc" (đòi chuyển khoản trước buổi thử) | "gia-mao" (hồ sơ giả / lớp ảo) | "khac"
//   status: "open" | "resolved";  resolution: "dismissed" | "locked"
model TutorProfileReport {
  id         String    @id @default(cuid())
  tutorId    String
  reason     String
  detail     String?   @db.Text
  channel    String?
  status     String    @default("open")
  resolution String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  tutor User @relation("ProfileReportTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, status])
  @@index([status, createdAt])
  @@map("tutor_profile_reports")
}

// ─── KẾ HOẠCH BUỔI 4 HOẠT ĐỘNG (PH-223) ───────────────────────────────────────────────────────────────────────
// Một lần soạn ra HAI bản: bản gia sư (đủ) và phiếu học sinh (chỉ câu hỏi dẫn đường + sản phẩm, KHÔNG đáp án, KHÔNG ghi chú gia sư).
// activities: mảng đúng 4 phần tử theo thứ tự mo-dau / hinh-thanh / luyen-tap / van-dung (xem src/lib/sessionPlan.ts).
// dateKey: ngày dạy theo giờ VN (YYYY-MM-DD), có thể trống khi mới soạn nháp.
model SessionPlan {
  id         String   @id @default(cuid())
  courseId   String
  tutorId    String
  dateKey    String?
  title      String
  goal       String?  @db.Text
  activities Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tutor User @relation("SessionPlanTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, courseId])
  @@index([tutorId, dateKey])
  @@map("session_plans")
}

// ─── ĐIỂM CHUẨN TUYỂN SINH (FE-099) ───────────────────────────────────────────────────────────────────────────
// Mỗi dòng = điểm chuẩn MỘT ngành/chương trình, MỘT năm, MỘT phương thức, kèm đường dẫn nguồn.
// Thang điểm khác nhau giữa các phương thức/năm (30, 90, 100, 150, 1200…) nên lưu kèm `scale` — không so sánh chéo thang.
// verified = quản trị đã đối chiếu với thông báo chính thức của trường (mặc định chưa).
// variant = chương trình/tổ hợp để phân biệt (VD "Chương trình tiên tiến"); chuỗi rỗng khi không có (để khoá duy nhất hoạt động).
model AdmissionScore {
  id         String   @id @default(cuid())
  school     String
  major      String
  variant    String   @default("")
  year       Int
  method     String
  score      Float
  scale      Int
  note       String?  @db.Text
  sourceUrl  String
  sourceName String
  verified   Boolean  @default(false)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([school, major, variant, year, method], name: "admission_score_key")
  @@index([published, year])
  @@map("admission_scores")
}

// ─── GIA SƯ DỜI / HUỶ MỘT BUỔI (hoàn thiện NV-189: dòng gợi ý loại 4) ──────────────────────────────────────────
// Định danh một buổi = (scheduleId, dateKey GỐC theo lịch tuần). Dời vẫn giữ định danh gốc để báo nghỉ và nhắc lịch của buổi đó
// không bị mồ côi; thời điểm hiệu lực lấy từ newDateKey / newStartTime / newEndTime (xem src/lib/sessionChange.ts).
//   cancel — buổi bị huỷ: không nhắc lịch, phụ huynh không báo nghỉ được nữa
//   move   — buổi dời sang newDateKey lúc newStartTime–newEndTime
// KHÔNG đụng tiền: học phí vẫn tính theo số buổi gia sư nhập (nối "không tính phí" vào phiếu là GD-25, chưa làm).
model ClassSessionChange {
  id           String    @id @default(cuid())
  courseId     String
  scheduleId   String // ClassSchedule.id — không FK: xoá khung giờ không được xoá lịch sử dời/huỷ
  dateKey      String // ngày GỐC theo lịch tuần, "YYYY-MM-DD" giờ VN
  kind         String // "cancel" | "move"
  newDateKey   String?
  newStartTime String? // "HH:mm"
  newEndTime   String? // "HH:mm"
  reason       String?   @db.Text
  changedBy    String // userId gia sư
  zaloOpenedAt DateTime? // gia sư ĐÃ MỞ Zalo để báo lớp — KiN không biết tin có đi thật hay không
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dateKey])
  @@index([courseId, dateKey])
  @@index([newDateKey])
  @@map("class_session_changes")
}

// ─── ĐĂNG NHẬP BẰNG MÃ 6 SỐ QUA EMAIL (TK-170, Figma "Đăng nhập" 21:9) ─────────────────────────────────────────
// Mỗi email có tối đa MỘT mã đang sống (email là khoá duy nhất): xin mã mới thì ghi đè mã cũ.
//   codeHash    — HMAC-SHA256(SESSION_SECRET, "email:mã"); KHÔNG lưu mã gốc; so bằng hàm so sánh thời gian hằng định.
//   attempts    — số lần nhập sai đã dùng. Trừ TRƯỚC khi so mã (nguyên tử) để gửi song song nhiều đoán mã cũng không vượt 5 lần;
//                 giữ qua các lần xin mã mới trong 15 phút để không lách bằng cách xin mã liên tục.
//   lockedUntil — đủ 5 lần sai thì khoá email này 15 phút (kể cả khi xin mã mới).
// Dùng xong (đúng mã) thì XOÁ dòng — mã một lần thì phải thật sự một lần. Xem src/lib/loginCode.ts.
model LoginCode {
  id          String    @id @default(cuid())
  email       String    @unique
  codeHash    String
  attempts    Int       @default(0)
  sentAt      DateTime  @default(now())
  expiresAt   DateTime
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("login_codes")
}
