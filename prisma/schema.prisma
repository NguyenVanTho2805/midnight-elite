// ─── TUTOR VIP SUBSCRIPTION ──────────────────────────────────────────────────
// Mô hình SaaS (D01 chốt 05/10/2026): gia sư trả phí VIP để mở full tính
// năng. 3 gói cố định (tháng / 6 tháng / 1 năm). Không phải "gói học viên
// mua lớp" như backlog BE-055 gốc. Học viên vẫn free trong giai đoạn này.
//
// Lưu lịch sử: mỗi lần mua tạo 1 bản ghi mới (không update bản cũ) — cho
// phép đối soát doanh thu và xem lịch sử nâng cấp của gia sư. Mua khi đang
// VIP: bản ghi mới nối tiếp (startDate = endDate gói trước).

model TutorSubscription {
  id              String   @id @default(cuid())
  userId          String   // gia sư mua gói
  planCode        String   // "monthly" | "half_year" | "yearly" (xem TUTOR_VIP_PLANS trong src/lib/tutorSubscription.ts)
  priceCoinPaid   Int      // snapshot giá tại thời điểm mua (có thể khác giá hiện tại nếu admin đổi sau)
  durationDays    Int      // snapshot thời hạn (30/180/365)
  startDate       DateTime @default(now()) // có thể ở tương lai nếu mua nối tiếp
  endDate         DateTime // startDate + durationDays — tính sẵn để query "còn hạn" chỉ cần 1 cột
  status          String   @default("active") // "active" | "expired" | "cancelled"
  // Note: Không có renewalFrom vì D10 (gia hạn tự động) đang HOÃN — mỗi lần
  // gia hạn hiện tại = mua gói mới hoàn toàn. Khi mở auto-renew sau, thêm
  // renewalFromId: String? trỏ về bản ghi gốc.
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, endDate])
  @@map("tutor_subscriptions")
}

model VerifyToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verify_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── ENROLLMENTS ──────────────────────────────────────────────────────────────

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  // Trạng thái của việc ghi danh. Mọi query coi "đã ghi danh" dùng để mở
  // quyền xem/làm bài phải lọc status = "active".
  //   - "pending_consent" : đang chờ phụ huynh xác nhận (học viên dưới ngưỡng
  //                          tuổi D04). Không có quyền học, nhưng hồ sơ giữ
  //                          nguyên để khi phụ huynh duyệt là bật ngay.
  //   - "active"          : đang học bình thường (mặc định)
  //   - "suspended"       : đã hết hạn gói hoặc bị tạm dừng — vẫn xem lại được
  //                          nội dung cũ nhưng không có hoạt động mới (R01).
  status String @default("active")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  parentConsent ParentConsent?

  @@unique([userId, courseId])
  @@index([status])
  @@map("enrollments")
}

// ─── TUITION (AS-192 + AS-193, chốt 06/10/2026) ───────────────────────────────
// Học phí tính THEO THÁNG, không theo buổi có mặt. Spec:
// docs/kin/quyet-dinh-giao-dien-va-hoc-phi.md mục 3.
//
// Công thức:
//   Đơn giá/buổi = tier theo tổng số môn em đăng ký (1 môn 70k, 2 môn 60k,
//                   3 môn 55k, 4 môn 50k) — có thể override per-user.
//   Học phí gốc  = Σ theo môn: (sessionCount − freeCount) × đơn giá
//   Phải đóng    = gốc − học bổng − giảm trừ (sàn 0)
//
// Vắng KHÔNG trừ tiền (D01). Attendance (AS-191) dùng cho chuyên cần, không
// cho học phí.

model MonthlyCourseFee {
  id           String   @id @default(cuid())
  courseId     String
  yearMonth    String // "YYYY-MM" — tránh timezone + dễ query
  sessionCount Int // số buổi của môn/lớp này trong tháng
  freeCount    Int      @default(0) // số buổi miễn phí (trial, bù)
  updatedBy    String // userId gia sư cập nhật
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  updater User   @relation("MonthlyCourseFeeUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@unique([courseId, yearMonth])
  @@index([yearMonth])
  @@map("monthly_course_fees")
}

// Override đơn giá/buổi cho 1 học viên — bỏ qua tier bậc thang. VD HS khó
// khăn được giảm xuống 40k/buổi dù đăng ký 2 môn (vẫn 60k theo tier). Set
// null hoặc xoá bản ghi để quay về tier.
model TuitionOverride {
  id              String   @id @default(cuid())
  userId          String   @unique
  pricePerSession Int
  note            String?  @db.Text
  updatedBy       String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  user    User @relation("TuitionOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  updater User @relation("TuitionOverrideUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@map("tuition_overrides")
}

// ─── ATTENDANCE (AS-191, chốt 06/10/2026) ─────────────────────────────────────
// Điểm danh theo buổi. 5 trạng thái:
//   "present"  → hệ số 1    (có mặt)
//   "late"     → hệ số 0.9  (muộn, GD-05)
//   "excused"  → hệ số 0.8  (nghỉ có phép)
//   "absent"   → hệ số 0.5  (vắng không phép)
//   (không có record)       → không tính (GD-06 "chưa điểm danh")
//
// Hệ số áp dụng cho CHUYÊN CẦN (NV-186), KHÔNG trừ học phí (D01 chốt
// "vắng không trừ tiền" — mục 3 trong quyet-dinh-giao-dien-va-hoc-phi.md:
// buổi nào cũng có bản ghi để xem lại).

model AttendanceSession {
  id         String   @id @default(cuid())
  courseId   String
  date       DateTime // ngày buổi học — unique với courseId để tránh trùng
  note       String?  @db.Text
  createdBy  String   // gia sư tạo (userId)
  createdAt  DateTime @default(now())

  // BU-01..BU-04, LI-11, LI-16, LI-17 (24/10/2026): cột THÊM, đều nullable. Buổi chưa có bản ghi vẫn suy từ quy luật tuần như cũ.
  // Chốt buổi chỉ GHI TRẠNG THÁI; không sinh/sửa/xoá FeeCharge hay phiếu (tiền vẫn do đường điểm danh sẵn có quyết định).
  state      String?   // null | "open" | "closed" — "closed" = gia sư bấm "Đã dạy xong"
  closedAt   DateTime?
  closedBy   String?
  reopenedAt DateTime? // lần mở lại gần nhất (để hiện "đã mở lại")
  taught     String?   @db.Text // ghi chép 1: nội dung đã dạy
  homework   String?   @db.Text // ghi chép 2: bài tập về nhà
  summary    String?   @db.Text // ghi chép 3: nhận xét chung của buổi
  mode       String?   // "online" | "offline"
  location   String?   // địa chỉ khi học offline
  joinUrl    String?   // link online RIÊNG buổi
  kind       String?   // null/"regular" = buổi theo lịch tuần | "extra" buổi lẻ | "makeup" dạy bù | "adhoc" phát sinh
  startTime  String?   // "HH:mm" — chỉ buổi lẻ/bù/phát sinh (buổi theo lịch lấy giờ từ ClassSchedule)
  endTime    String?

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator  User                @relation("AttendanceSessionCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  records  AttendanceRecord[]
  scores   SessionStudentScore[]

  @@unique([courseId, date])
  @@index([courseId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String   // học viên
  status     String   // "present" | "late" | "excused" | "absent"
  note       String?  @db.Text
  updatedBy  String?  // userId gia sư cập nhật lần cuối
  // TT-199: gia sư ĐÃ MỞ Zalo để nhắn phụ huynh về buổi này. Đổi trạng thái điểm danh thì xoá mốc
  // (tin cũ nói về trạng thái cũ). KiN không biết tin có đi thật hay không.
  zaloOpenedAt DateTime?
  // BU-07: gia sư tick "cho phụ huynh của em này xem nhận xét". Mặc định KHÔNG. Chỉ hiện qua link Sổ của con của đúng em đó.
  parentVisible Boolean @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User              @relation("AttendanceRecordStudent", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("attendance_records")
}

// ─── BÁO NGHỈ SÁT GIỜ, BUỔI BÙ, NHẮC LỊCH (TT-201/202/203) ───────────────────
// Quy tắc: docs/kin/nghiep-vu/lich-nhac-va-che-do-gon.md. Buổi học KHÔNG có bản ghi
// riêng (ClassSchedule là quy luật lặp hàng tuần), nên một buổi được định danh bằng
// (scheduleId, dateKey) với dateKey = "YYYY-MM-DD" theo giờ Việt Nam.

// Một lần phụ huynh báo con nghỉ một buổi cụ thể.
//   excused_auto — báo trước ≥ 2 giờ: tự ghi "Nghỉ có báo", tự giữ 1 buổi bù
//   pending      — báo dưới 2 giờ: chờ gia sư bấm 1 nút (hiện ở Hộp việc / chấm trên Lịch)
//   excused_free — gia sư chọn "Không tính phí, giữ 1 buổi bù"
//   charged      — gia sư chọn "Tính phí buổi này" (không có buổi bù)
//   voided       — gia sư HUỶ buổi khi báo nghỉ còn "pending": buổi không diễn ra nên không tính phí, không buổi bù
model ClassAbsence {
  id          String    @id @default(cuid())
  courseId    String
  scheduleId  String // ClassSchedule.id — không FK: xoá khung giờ không được xoá lịch sử báo nghỉ
  dateKey     String // "YYYY-MM-DD" giờ VN
  startAt     DateTime // thời điểm bắt đầu buổi, chốt lúc báo (đổi lịch sau không làm lệch lịch sử)
  studentId   String
  reportedBy  String // "parent" | "student"
  reportedAt  DateTime  @default(now())
  leadMinutes Int // số phút báo trước giờ học
  reason      String?   @db.Text
  status      String
  resolvedAt  DateTime?
  resolvedBy  String? // userId gia sư xử lý (null với excused_auto)
  createdAt   DateTime  @default(now())

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User          @relation("AbsenceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  makeup  MakeupCredit?

  @@unique([scheduleId, dateKey, studentId])
  @@index([courseId, status])
  @@index([studentId])
  @@map("class_absences")
}

// Buổi bù: sinh ra cùng lúc với một ClassAbsence miễn phí (đúng 1 buổi bù cho 1 lần nghỉ,
// ép bằng absenceId @unique). Hết hạn sau 30 ngày; "hết hạn" suy ra từ expiresAt chứ không
// có cron đổi trạng thái. Dùng khi gia sư điểm danh một buổi mới (usedSessionId).
model MakeupCredit {
  id            String    @id @default(cuid())
  studentId     String
  courseId      String
  absenceId     String    @unique
  grantedAt     DateTime  @default(now())
  expiresAt     DateTime
  status        String    @default("active") // "active" | "used"
  usedAt        DateTime?
  usedSessionId String?

  student User         @relation("MakeupStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  absence ClassAbsence @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([courseId, status, expiresAt])
  @@map("makeup_credits")
}

// Nhật ký "Đã mở Zalo lúc …" (TT-199 giai đoạn 1): KiN chỉ biết gia sư đã MỞ Zalo với tin
// soạn sẵn, không biết tin đã đi thật hay chưa nên không bao giờ ghi "đã gửi". Mỗi
// (buổi × học sinh × bên nhận × loại tin) tối đa một dòng ⇒ tối đa 2 tin nhắc cho mỗi bên,
// mỗi buổi.
model ClassReminderLog {
  id         String   @id @default(cuid())
  courseId   String
  scheduleId String
  dateKey    String
  studentId  String
  recipient  String // "parent" | "student"
  kind       String // "h24" | "h1"
  tutorId    String
  openedAt   DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation("ReminderStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   User   @relation("ReminderTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dateKey, studentId, recipient, kind])
  @@index([courseId, dateKey])
  @@map("class_reminder_logs")
}

// ─── PHIẾU HỌC PHÍ + ĐỐI SOÁT VIETQR (TT-200) ────────────────────────────────
// Nguyên tắc (docs/kin/nghiep-vu/doi-soat-vietqr.md): tiền đi THẲNG vào tài
// khoản của gia sư — KiN không giữ, không thu hộ, không cắt phần trăm. KiN chỉ
// ĐỌC tiền vào qua dịch vụ trung gian (SePay) do gia sư tự mở, và chỉ tự gạch
// phiếu khi chắc chắn (đúng mã + đúng số tiền còn lại). Không bao giờ tự ghép
// theo số tiền (GD-20). Không lưu số dư tài khoản của gia sư (GD-22).

// Tài khoản nhận học phí của gia sư + khoá webhook. Khoá lưu BĂM (sha256), chỉ
// hiện bản rõ đúng 1 lần lúc tạo/đổi — lộ DB cũng không làm giả được webhook.
model TutorPayoutAccount {
  userId         String    @id
  bankBin        String // BIN VietQR 6 số, vd "970436"
  accountNo      String
  accountName    String // IN HOA không dấu, đúng tên chủ tài khoản
  webhookKeyHash String? // sha256 hex của khoá SePay gửi kèm (Authorization: Apikey …)
  webhookKeyHint String? // 4 ký tự cuối để gia sư nhận ra khoá nào
  webhookSeenAt  DateTime? // lúc nhận giao dịch đầu tiên → "Đang nối SePay"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation("PayoutAccountUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_payout_accounts")
}

// Phiếu học phí của 1 em trong 1 tháng. `code` KHÔNG ĐỔI kể cả khi sửa số tiền
// (GD-19). `amountDue` là số tiền CHỐT lúc lập (quy tắc tiền chốt vào sự kiện):
// gia sư tăng giá sau đó thì phiếu cũ giữ nguyên.
//   draft → sent → parent_reported → partial → paid ;  bất kỳ lúc nào → cancelled
model TuitionInvoice {
  id               String    @id @default(cuid())
  code             String    @unique // "KIN" + 5 ký tự A–Z/2–9 bỏ O I L
  tutorId          String
  studentId        String
  yearMonth        String // "YYYY-MM"
  amountDue        Int // VND, không làm tròn
  paidAmount       Int       @default(0)
  status           String    @default("draft") // draft | sent | parent_reported | partial | paid | cancelled
  breakdown        Json? // ảnh chụp computeMonthlyFee + tín dụng đã trừ, để in lại đúng
  cancelReason     String?   @db.Text
  sentAt           DateTime?
  parentReportedAt DateTime?
  paidAt           DateTime?
  // TT-199 giai đoạn 1: link riêng xem phiếu không cần tài khoản (hết hạn 60 ngày, GD-28).
  // KHÔNG @unique (xem ghi chú ở ParentLink.portalToken: db push trên cột cũ).
  viewToken          String?
  viewTokenExpiresAt DateTime?
  zaloOpenedAt       DateTime? // gia sư ĐÃ MỞ Zalo — KiN không biết tin có đi thật hay không
  parentViewedAt     DateTime? // phụ huynh mở link (ghi từ trình duyệt, không phải khi bot xem trước link)
  // F2 (23/10/2026): HẠN ĐÓNG do gia sư đặt, "YYYY-MM-DD" theo giờ VN. null = chưa đặt (tin Zalo giữ chữ cũ "hạn trước ngày 20").
  // Chỉ để trình bày và nhắc; KHÔNG đổi số tiền, KHÔNG đổi trạng thái phiếu.
  dueDate            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tutor   User @relation("InvoiceTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student User @relation("InvoiceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]
  reminders    InvoiceReminder[]

  @@unique([tutorId, studentId, yearMonth])
  @@index([tutorId, yearMonth])
  @@index([studentId])
  @@index([viewToken])
  @@map("tuition_invoices")
}

// F2 (23/10/2026) — lịch sử nhắc học phí theo phiếu: mỗi lần gia sư BẤM MỞ ZALO là một dòng (step 1–3).
// KiN không biết tin có đi thật hay không nên đây chỉ là "đã mở Zalo lúc …", không bao giờ là "đã gửi". Không tự gạch nợ.
model InvoiceReminder {
  id        String   @id @default(cuid())
  invoiceId String
  tutorId   String
  step      Int // 1 | 2 | 3
  openedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  invoice TuitionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, step])
  @@index([tutorId, openedAt])
  @@map("invoice_reminders")
}

// Mỗi khoản tiền vào (SePay hoặc gia sư tự ghi tiền mặt) là 1 dòng — có dấu vết
// ai bấm, lúc nào. Chống trùng: (tutorId, provider, providerTxId) là duy nhất.
//   kind   : exact | short | over | already_paid | cancelled | unknown_code | no_code
//   status : matched (tự gạch) | pending (chờ gia sư) | resolved (gia sư đã xử lý) | ignored
model BankTransaction {
  id                  String    @id @default(cuid())
  tutorId             String
  provider            String    @default("sepay") // "sepay" | "manual"
  providerTxId        String
  occurredAt          DateTime
  amount              Int
  content             String    @db.Text
  providerCode        String? // trường `code` SePay đã tách sẵn
  referenceCode       String?
  gateway             String?
  matchedCode         String? // mã KIN tìm được trong code/content
  invoiceId           String?
  appliedAmount       Int       @default(0) // phần đã cộng vào phiếu
  kind                String
  status              String
  resolution          String? // auto_matched | applied_partial | credit_next_month | refunded | matched_manual | manual_cash | not_tuition
  resolvedBy          String?
  resolvedAt          DateTime?
  suggestedInvoiceIds String[]  @default([]) // gợi ý cùng số tiền — KHÔNG tự ghép
  // HP-20 (23/10/2026): hình thức khi gia sư tự ghi tay: "cash" | "bank_transfer". null = bản ghi cũ (coi là tiền mặt) hoặc
  // tiền vào qua SePay. Ngày thu của khoản ghi tay chính là `occurredAt` (báo cáo doanh thu đã tính theo cột này).
  method              String?
  createdAt           DateTime  @default(now())

  tutor   User            @relation("BankTxTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  invoice TuitionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([tutorId, provider, providerTxId])
  @@index([tutorId, status])
  @@index([invoiceId])
  @@map("bank_transactions")
}

// Tiền đóng dư gia sư chọn "Trừ vào tháng sau". Lập phiếu tháng kế tiếp tự trừ
// theo thứ tự cũ → mới và ghi vào breakdown của phiếu.
model TuitionCredit {
  id         String    @id @default(cuid())
  tutorId    String
  studentId  String
  amount     Int // số tiền dư ban đầu
  usedAmount Int       @default(0)
  sourceTxId String?
  createdAt  DateTime  @default(now())

  tutor   User @relation("CreditTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student User @relation("CreditStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tutorId, studentId])
  @@map("tuition_credits")
}

// HP-21 (23/10/2026): nhật ký hoàn tác một khoản đã thu. BẢNG MỚI, chỉ thêm dòng, không sửa/xoá dòng cũ. Một khoản tiền có thể
// bị hoàn tác nhiều lần (ghép sai → hoàn tác → ghép lại → hoàn tác) nên không đặt cột hoàn tác trên BankTransaction.
// Không khoá ngoại tới người dùng (tránh đụng model User); tutorId/bankTransactionId/invoiceId chỉ để tra cứu.
//   outcome: "requeued" (khoản tiền thật đã vào TK gia sư → quay lại hàng chờ đối soát)
//            "voided"   (khoản gia sư tự ghi tay → coi như ghi nhầm, loại khỏi doanh thu)
model PaymentReversal {
  id                String   @id @default(cuid())
  tutorId           String
  bankTransactionId String
  invoiceId         String
  reversedAmount    Int // phần đã cộng vào phiếu nay được trừ ra
  reason            String   @db.Text
  outcome           String
  invoiceStatusFrom String
  invoiceStatusTo   String
  creditsVoided     Int      @default(0) // tổng tiền dư (tín dụng tháng sau) được thu hồi
  reversedBy        String
  createdAt         DateTime @default(now())

  @@index([tutorId, createdAt])
  @@index([bankTransactionId])
  @@index([invoiceId])
  @@map("payment_reversals")
}

// ─── HỌC PHÍ KIỂU MỚI (HP-14..HP-17, 23/10/2026) ──────────────────────────────────────────────────────────────
// Chỉ lớp có Course.feeMode khác "monthly_sessions" dùng các bảng này. Lớp cũ không có dòng nào ở đây và phiếu của lớp cũ
// KHÔNG đổi một đồng. Bảng MỚI; không khoá ngoại tới User (tránh đụng model User), chỉ khoá tới Course (xoá lớp thì xoá theo).
// Quy tắc "tiền chốt vào sự kiện": FeeCharge lưu số tiền đã tính ngay lúc điểm danh; khi vào phiếu (invoiceId) thì ĐÓNG BĂNG.

// Lịch sử đơn giá của lớp. Đơn giá áp cho buổi có ngày >= effectiveFrom (ngày VN, "YYYY-MM-DD"); buổi trước đơn giá đầu tiên dùng đơn giá đầu tiên.
//   per_session: rate = đ / buổi ; per_hour: rate = đ / giờ + sessionMinutes ; per_course: rate = đ / khoá / học sinh.
model CourseFeeRate {
  id             String   @id @default(cuid())
  courseId       String
  mode           String
  rate           Int
  sessionMinutes Int? // chỉ per_hour: một buổi dài bao nhiêu phút
  effectiveFrom  String
  note           String?  @db.Text
  createdBy      String
  createdAt      DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, effectiveFrom])
  @@index([courseId])
  @@map("course_fee_rates")
}

// HP-17: đơn giá riêng cho một cặp (học sinh, lớp). Cùng đơn vị với đơn giá lớp (đ/buổi, đ/giờ hoặc đ/khoá). Có hiệu lực từ ngày.
// Không dùng TuitionOverride (đó là giá theo em TOÀN CỤC của cách tính cũ, giữ nguyên).
model CourseStudentRate {
  id            String   @id @default(cuid())
  courseId      String
  studentId     String
  rate          Int
  effectiveFrom String
  note          String?  @db.Text
  createdBy     String
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, effectiveFrom])
  @@index([courseId, studentId])
  @@map("course_student_rates")
}

// Một dòng phí đã tính. kind: "session" (một buổi, gắn recordId) | "course" (cả khoá, một lần) | "extra" (phí khác, HP-18).
// invoiceId null = chưa vào phiếu nào (còn sửa được: đổi đơn giá, đổi trạng thái điểm danh). Đã vào phiếu = đóng băng.
model FeeCharge {
  id         String   @id @default(cuid())
  tutorId    String
  courseId   String
  studentId  String
  kind       String
  recordId   String? // AttendanceRecord.id cho kind=session. Nullable nên @unique cho phép nhiều dòng không có recordId.
  dateKey    String // ngày VN của buổi / ngày phát sinh
  yearMonth  String // tháng của dateKey — phiếu tháng đó gom dòng này
  amount     Int // đồng, đã làm tròn từng dòng
  units      Int? // per_hour: số phút của buổi
  rate       Int? // đơn giá đã áp
  rateSource String   @default("class") // "class" | "student"
  mode       String
  label      String? // kind=extra: tên khoản (tài liệu, quỹ lớp…)
  invoiceId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([recordId])
  @@index([tutorId, studentId, yearMonth])
  @@index([courseId, dateKey])
  @@index([invoiceId])
  @@map("fee_charges")
}

// HP-31 (24/10/2026): gói buổi trả trước và sổ sử dụng. SỔ BUỔI, không phải sổ tiền: KiN không thu, không chuyển, không gạch nợ.
// Chỉ lớp kiểu mới theo buổi / theo giờ. Một gói = N buổi cho MỘT em trong MỘT lớp; mỗi buổi ĐÃ CHỐT em có mặt/muộn (không dùng buổi bù) trừ 1 buổi.
// unitPrice / totalPrice CHỤP lúc lập theo đơn giá lớp (hoặc giá riêng của em) để ghi lại thôi; đổi đơn giá sau không đổi gói. Bảng MỚI, không đụng phiếu / dòng phí.
// CẦN KẾ TOÁN DUYỆT cách ghi nhận (có trừ khỏi phiếu hay không) trước khi dùng thật: hiện sổ buổi KHÔNG tự bớt khoản nào trên phiếu.
model SessionPackage {
  id          String    @id @default(cuid())
  tutorId     String
  courseId    String
  studentId   String
  sessions    Int // số buổi trong gói
  unitPrice   Int // đồng / buổi, chụp lúc lập
  totalPrice  Int // sessions × unitPrice, chụp lúc lập
  status      String    @default("active") // "active" | "used_up" | "cancelled"
  note        String?
  createdBy   String
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  course Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uses   SessionPackageUse[]

  @@index([courseId, studentId, status])
  @@index([tutorId])
  @@map("session_packages")
}

// Một lần trừ buổi của gói. Mỗi bản ghi điểm danh trừ tối đa MỘT buổi (unique recordId). Trả buổi = đặt reversedAt (giữ lịch sử), không xoá.
model SessionPackageUse {
  id         String    @id @default(cuid())
  packageId  String
  recordId   String // AttendanceRecord.id
  sessionId  String
  dateKey    String // ngày VN của buổi
  usedAt     DateTime  @default(now())
  reversedAt DateTime?

  package SessionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([recordId])
  @@index([packageId])
  @@index([sessionId])
  @@map("session_package_uses")
}

// HP-32 (23/10/2026): giảm giá PHẦN TRĂM của gia sư cho một học sinh, áp tự động khi LẬP PHIẾU MỚI (phiếu đã lập không đổi).
// Một dòng cho mỗi cặp (gia sư, học sinh): đặt lại thì ghi đè, xoá = đặt 0%. Lịch sử đổi nằm ở nhật ký hệ thống. Bảng MỚI.
model StudentDiscount {
  id        String   @id @default(cuid())
  tutorId   String
  studentId String
  percent   Int // 1..100
  note      String?  @db.Text
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tutorId, studentId])
  @@index([tutorId])
  @@map("student_discounts")
}

// ─── COIN TOPUP REQUEST (FE-128) ──────────────────────────────────────────────
// User yêu cầu nạp Coin (chủ yếu gia sư nạp để mua VIP, D01 chốt). Chuyển
// khoản ngân hàng thủ công — admin đối chiếu rồi approve, hệ thống cộng
// Coin vào Wallet + ghi CoinTransaction.
//
// Không gộp vào CoinTransaction vì:
//  - CoinTransaction là ghi sổ sau khi đã cộng/trừ xong (ăn khớp balance).
//  - Topup có 3 trạng thái: pending (chưa cộng), approved (đã cộng + có
//    CoinTransaction), rejected (không cộng, giữ bản ghi để tra cứu).
model CoinTopupRequest {
  id          String    @id @default(cuid())
  userId      String
  amountVnd   Int // số VND user báo đã chuyển
  coinAmount  Int // số Coin cộng khi approve (1 Coin = 1 VND trong giai đoạn này)
  status      String    @default("pending") // "pending" | "approved" | "rejected"
  bankRef     String? // mã giao dịch người dùng khai báo (nếu có)
  note        String?   @db.Text // ghi chú user khai
  rejectReason String?  @db.Text
  reviewedBy  String? // admin userId
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  user     User  @relation("TopupRequests",      fields: [userId],     references: [id], onDelete: Cascade)
  reviewer User? @relation("TopupRequestReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("coin_topup_requests")
}

// ─── CLASS INVITE (BE-063 — 1.4.6) ────────────────────────────────────────────
// Mã mời vào lớp do gia sư tạo. Dùng để học viên tự redeem (nhập tay hoặc theo
// link) thay vì admin phải gán từng người. Khác ParentConsent.token (32 byte
// hex, 1 lần dùng): ClassInvite.code là mã rút gọn 8 ký tự base32 (loại trừ
// 0/1/I/O cho dễ đọc/gõ), có thể dùng nhiều lần tới `maxUses` và/hoặc tới
// `expiresAt`.
//
// `revoked = true` giữ bản ghi để lịch sử — không xoá hẳn (BE-066).
model ClassInvite {
  id         String    @id @default(cuid())
  courseId   String
  code       String    @unique
  maxUses    Int? // null = không giới hạn
  usedCount  Int       @default(0)
  expiresAt  DateTime? // null = không hết hạn
  revoked    Boolean   @default(false)
  createdBy  String
  createdAt  DateTime  @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator User   @relation("ClassInviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("class_invites")
}

// ─── PARENT LINKS & CONSENT ───────────────────────────────────────────────────
// Xác thực quan hệ phụ huynh–học viên (G1.04) và ghi nhận đồng ý khi học viên
// dưới ngưỡng tuổi tham gia lớp (G2.07–G2.11, D04). User.parentPhone/parentName
// là dữ liệu cũ tự khai, KHÔNG được dùng làm nguồn cấp quyền — chỉ ParentLink
// có status "verified" mới được coi là quan hệ phụ huynh hợp lệ.
// Xem files/07_ke_hoach_chuyen_doi_gia_su.md mục 3.3 để biết bối cảnh.

model ParentLink {
  id         String    @id @default(cuid())
  parentId   String
  studentId  String
  status     String    @default("pending") // "pending" | "verified" | "revoked"
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  // TK-178 (09/10/2026): token xem "Sổ của con" không cần đăng nhập, cho
  // phụ huynh chưa đăng ký tài khoản xem báo cáo của con. Token sinh 1 lần
  // (gia sư copy link gửi Zalo), có thể revoke bằng cách set NULL. Chỉ bật
  // khi status = "verified". KHÔNG có hạn tự động — gia sư chủ động revoke
  // khi em nghỉ lớp, tránh phụ huynh phàn nàn "sao hết link rồi".
  //
  // KHÔNG @unique: Prisma coi việc thêm UNIQUE lên cột cũ là "data loss"
  // nên db push yêu cầu --accept-data-loss, kẹt production build. Entropy
  // 128 bit từ generatePortalToken (16 bytes random) đã đủ chống trùng
  // trong thực tế. @@index để query token nhanh.
  portalToken String?

  parent  User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  consents ParentConsent[]

  @@unique([parentId, studentId])
  @@index([studentId])
  @@index([portalToken])
  @@map("parent_links")
}

// 1 bản ghi đồng ý cho 1 lần enrollment cụ thể cần xác nhận (học viên dưới
// ngưỡng tuổi). Token dùng 1 lần, có hạn — không được tái sử dụng sau khi đã
// approved/rejected/expired (G2.08, G2.11).
model ParentConsent {
  id             String    @id @default(cuid())
  parentLinkId   String
  enrollmentId   String?   @unique
  token          String    @unique
  status         String    @default("pending") // "pending" | "approved" | "rejected" | "expired"
  contentVersion String // phiên bản nội dung xác nhận đã hiển thị cho phụ huynh, để đối chiếu khi có tranh chấp
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())

  parentLink ParentLink  @relation(fields: [parentLinkId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([parentLinkId])
  @@map("parent_consents")
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────
// Nhật ký các hành động đổi quyền/đồng ý có ảnh hưởng tới người khác (G1.13,
// P0). Bắt đầu từ ParentLink/ParentConsent (verify/revoke/approve/reject) —
// đổi quyền, điểm, Coin sẽ nối dần vào các luồng liên quan sau, dùng chung
// action namespace dạng "resource.event" (vd "parent_link.verify").
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String? // null nếu hệ thống tự thực hiện (vd hết hạn tự động)
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@map("audit_logs")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "enrollment" | "exam_new" | "exam_reminder" | "thread_reply" | "thread_like" | "reply_like" | "article_new" | "parent_link_request" | "parent_link_verified" | "parent_consent_requested" | "parent_consent_responded"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  count     Int      @default(1) // số lượt gộp — vd "X và 4 người khác đã thích..."
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── THÔNG BÁO ĐẨY (ĐX-02) ────────────────────────────────────────────────────
// Mỗi dòng là MỘT trình duyệt / thiết bị của gia sư đã bật "Thông báo đẩy". `endpoint` + `p256dh` + `auth` là thứ trình duyệt cấp
// (khoá công khai của thiết bị, không phải bí mật của tài khoản). `endpoint` unique: một thiết bị đổi tài khoản thì dòng chuyển sang người mới.
// `revokedAt` đặt khi dịch vụ đẩy trả 404/410 (thiết bị đã gỡ quyền) — không gửi nữa; người dùng bấm tắt / gỡ thì XOÁ hẳn dòng.
// Chữ gửi đi dựng từ LOẠI thông báo (src/lib/pushRules.ts), không đọc từ bảng notifications.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("push_subscriptions")
}

// ─── LESSON PROGRESS ──────────────────────────────────────────────────────────

model LessonProgress {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  completedAt    DateTime @default(now())
  watchedSeconds Int      @default(0)
  // true = đã xong; false = đang xem dở (chỉ lưu giây xem). Hàng cũ mặc định true (trước đây hàng nào có mặt cũng bị coi là "xong").
  completed      Boolean  @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ─── FILE ASSETS ──────────────────────────────────────────────────────────────
// Tệp gia sư tải lên KiN (hiện là VIDEO bài giảng; tài liệu sẽ ghi bytes ở đây khi cần, MD-08). Chỉ THÊM.
// Không có địa chỉ công khai: phát qua /api/media/[id]/stream sau khi kiểm quyền (src/lib/lessonGuard.ts canWatchStoredMedia).
// Bài giảng tham chiếu bằng "kin-media:<id>" trong Lesson.videoUrl.
model FileAsset {
  id           String   @id @default(cuid())
  ownerId      String // gia sư tải lên
  courseId     String // lớp chứa bài
  lessonId     String? // gắn khi lưu bài
  kind         String   @default("video") // "video" | "document"
  driver       String // "local" | "cloudinary"
  storageKey   String // đường dẫn trong kho (local: tên tệp; cloudinary: public_id)
  mimeType     String
  bytes        Int? // null khi chưa tải xong
  originalName String
  status       String   @default("pending") // "pending" | "ready"
  createdAt    DateTime @default(now())

  @@index([ownerId])
  @@index([courseId])
  @@index([lessonId])
  @@map("file_assets")
}

// ─── BẢN GHI CỦA LỚP (MD-02) ──────────────────────────────────────────────────
// Link CHỮ gia sư dán sau buổi học (YouTube / Drive / Vimeo / Zoom cloud; đã qua src/lib/mediaLink.ts). KiN không lưu tệp video.
// sessionId = AttendanceSession.id (buổi học) — cố ý KHÔNG khai báo quan hệ để không đụng model buổi; null = chưa gắn buổi nào. Chỉ THÊM.
model ClassRecording {
  id        String   @id @default(cuid())
  courseId  String
  sessionId String?
  title     String
  url       String
  kind      String // "youtube" | "vimeo" | "drive" | "zoom_record"
  createdBy String
  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([sessionId])
  @@map("class_recordings")
}

// ─── AZOTA: HỌC SINH BÁO "ĐÃ LÀM" ─────────────────────────────────────────────
// Lời khai của học sinh rằng đã làm bài Azota của một bài giảng (KiN không biết thật), kèm LINK bài làm (không bắt buộc).
// Bảng riêng, KHÔNG dùng Assignment: tránh bài "ảo" lọt vào danh sách bài tập, hàng đợi chấm và số "chưa chấm" của gia sư.
// Không có trường ảnh: KiN không nhận ảnh bài làm của học sinh dưới 16 tuổi. Chỉ THÊM.
model LessonAzotaDone {
  id       String   @id @default(cuid())
  lessonId String
  userId   String
  kind     String   @default("done") // "done" (chỉ bấm Em đã làm xong) | "link" (kèm link bài làm trên azota.vn)
  linkUrl  String?
  doneAt   DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([lessonId])
  @@map("lesson_azota_done")
}

// ─── LESSON NOTES ─────────────────────────────────────────────────────────────
// Ghi chú cá nhân của học sinh cho từng bài học — trước đây lưu localStorage
// nên không đồng bộ giữa các thiết bị (mobile/web riêng), giờ lưu DB thật.

model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  text      String   @db.Text
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_notes")
}

// ─── EXAM RESULTS ─────────────────────────────────────────────────────────────

model ExamResult {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  score       Float
  totalPoints Int      @default(150)
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@map("exam_results")
}

// ─── BADGES ───────────────────────────────────────────────────────────────────

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── COMMUNITY ────────────────────────────────────────────────────────────────

model Thread {
  id        String    @id @default(cuid())
  content   String    @db.Text
  authorId  String
  category  String    @default("hoi-dap")
  isPinned  Boolean   @default(false)
  imageUrls String[]
  fileUrl   String?
  fileName  String?
  deletedAt DateTime? // soft-delete — xoá thật để lại dấu vết, tránh mất bằng chứng khi có tranh chấp
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Phạm vi bài viết: null = "cộng đồng chung" cho mọi học viên (giữ hành vi
  // cũ cho bài trước thời điểm triển khai 1.4.7); có courseId = thread riêng
  // của lớp đó, chỉ members của lớp (học viên Enrollment.active + GVCN
  // Course.ownerId) được post và xem (sẽ enforce ở route — xem BE-071).
  // onDelete SetNull: khi xoá lớp, bài viết chuyển về "cộng đồng chung" chứ
  // không mất dấu vết.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ThreadReply[]
  likes     ThreadLike[]
  bookmarks ThreadBookmark[]
  reports   ThreadReport[]

  @@index([courseId])
  @@map("threads")
}

model ThreadReport {
  id         String   @id @default(cuid())
  threadId   String
  reporterId String
  reason     String
  status     String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt  DateTime @default(now())

  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([threadId, reporterId])
  @@map("thread_reports")
}

model ThreadReply {
  id        String    @id @default(cuid())
  content   String    @db.Text
  authorId  String
  threadId  String
  imageUrls String[]
  deletedAt DateTime? // soft-delete, xem giải thích ở Thread.deletedAt
  createdAt DateTime  @default(now())

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  thread Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  likes  ReplyLike[]

  @@map("thread_replies")
}

model ThreadLike {
  userId   String
  threadId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([userId, threadId])
  @@map("thread_likes")
}

model ReplyLike {
  userId  String
  replyId String

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply ThreadReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@id([userId, replyId])
  @@map("reply_likes")
}

model ThreadBookmark {
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([userId, threadId])
  @@map("thread_bookmarks")
}

// ─── COIN ECONOMY & HỎI ĐÁP (Knowledge Bounty) ────────────────────────────────
// Đặt câu hỏi mất xu (phí cố định), trả lời được chấp nhận nhận xu thưởng
// (hệ thống cấp riêng, không lấy từ phí người hỏi). Report sai/spam do admin
// duyệt — nếu đúng, trừ lại xu thưởng đã nhận.

model Wallet {
  userId  String @id
  balance Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // dương = cộng, âm = trừ
  reason    String // mã nghiệp vụ cụ thể — xem COIN_REASONS trong src/lib/wallet-constants.ts
  refId     String? // id câu hỏi/trả lời liên quan (để truy vết)
  // Phân loại nguồn dòng tiền ở cấp cao hơn `reason` — dùng cho báo cáo doanh
  // thu và lọc lịch sử theo lớp. Giá trị: "topup" | "reward" |
  // "class_subscription" | "refund" | "penalty". Nullable vì bản ghi cũ chưa
  // có — tuyệt đối không suy đoán ngược từ reason (xem BE-039).
  sourceType String?
  // Lớp liên quan — gắn khi sourceType = "class_subscription" (phí mua gói),
  // hoặc các giao dịch được quy về lớp (hoàn/phạt theo lớp). Nullable cho các
  // giao dịch không gắn lớp như signup_bonus/thread_reward.
  classId    String?
  createdAt  DateTime @default(now())

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Course? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([classId])
  @@index([sourceType])
  @@map("coin_transactions")
}

model Question {
  id               String   @id @default(cuid())
  authorId         String
  title            String
  content          String   @db.Text
  bountyPaid       Int // số xu đã trừ khi đăng (lưu lại để minh bạch)
  status           String   @default("open") // "open" | "answered"
  acceptedAnswerId String?  @unique
  createdAt        DateTime @default(now())

  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers        Answer[] @relation("QuestionAnswers")
  acceptedAnswer Answer?  @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id])

  @@map("questions")
}

model Answer {
  id          String   @id @default(cuid())
  questionId  String
  authorId    String
  content     String   @db.Text
  rewardPaid  Int? // số xu đã thưởng (null nếu chưa được chấp nhận)
  isPenalized Boolean  @default(false) // đã bị admin duyệt report và trừ xu
  createdAt   DateTime @default(now())

  question    Question       @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  acceptedFor Question?      @relation("AcceptedAnswer")
  reports     AnswerReport[]

  @@map("answers")
}

model AnswerReport {
  id         String   @id @default(cuid())
  answerId   String
  reporterId String
  reason     String
  status     String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt  DateTime @default(now())

  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([answerId, reporterId])
  @@map("answer_reports")
}

// ─── NEWS / ARTICLES ──────────────────────────────────────────────────────────

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  content     String    @db.Text
  category    String
  author      String
  authorId    String
  tag         String?
  isPinned    Boolean   @default(false)
  published   Boolean   @default(false)
  readTime    Int       @default(5)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("articles")
}

// ─── PHỄU GIA SƯ (PH-207..212, đặc tả pheu-gia-su.md) ─────────────────────────
// Mỗi lượt mở link hồ sơ công khai ghi 1 dòng theo đuôi ?n= (kênh). Không đếm được bài đăng trong nhóm Facebook,
// chỉ đếm lượt bấm link. visitorKey là mã NGẪU NHIÊN theo phiên trình duyệt, chỉ để không đếm trùng — không phải định danh người.
//   kind: "open" (mở link) | "full" (kéo tới cuối hồ sơ)
model ProfileVisit {
  id         String   @id @default(cuid())
  tutorId    String
  channel    String
  kind       String
  visitorKey String
  createdAt  DateTime @default(now())

  tutor User @relation("ProfileVisitTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, channel, kind, visitorKey])
  @@index([tutorId, createdAt])
  @@index([channel, createdAt])
  @@map("profile_visits")
}

// Báo cáo hồ sơ gia sư (chống lừa đảo). Ai cũng gửi được, không cần tài khoản.
//   reason: "thu-phi-truoc" (đòi chuyển khoản trước buổi thử) | "gia-mao" (hồ sơ giả / lớp ảo) | "khac"
//   status: "open" | "resolved";  resolution: "dismissed" | "locked"
model TutorProfileReport {
  id         String    @id @default(cuid())
  tutorId    String
  reason     String
  detail     String?   @db.Text
  channel    String?
  status     String    @default("open")
  resolution String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  tutor User @relation("ProfileReportTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, status])
  @@index([status, createdAt])
  @@map("tutor_profile_reports")
}

// ─── KẾ HOẠCH BUỔI 4 HOẠT ĐỘNG (PH-223) ───────────────────────────────────────────────────────────────────────
// Một lần soạn ra HAI bản: bản gia sư (đủ) và phiếu học sinh (chỉ câu hỏi dẫn đường + sản phẩm, KHÔNG đáp án, KHÔNG ghi chú gia sư).
// activities: mảng đúng 4 phần tử theo thứ tự mo-dau / hinh-thanh / luyen-tap / van-dung (xem src/lib/sessionPlan.ts).
// dateKey: ngày dạy theo giờ VN (YYYY-MM-DD), có thể trống khi mới soạn nháp.
model SessionPlan {
  id         String   @id @default(cuid())
  courseId   String
  tutorId    String
  dateKey    String?
  title      String
  goal       String?  @db.Text
  activities Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tutor User @relation("SessionPlanTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, courseId])
  @@index([tutorId, dateKey])
  @@map("session_plans")
}

// ─── ĐIỂM CHUẨN TUYỂN SINH (FE-099) ───────────────────────────────────────────────────────────────────────────
// Mỗi dòng = điểm chuẩn MỘT ngành/chương trình, MỘT năm, MỘT phương thức, kèm đường dẫn nguồn.
// Thang điểm khác nhau giữa các phương thức/năm (30, 90, 100, 150, 1200…) nên lưu kèm `scale` — không so sánh chéo thang.
// verified = quản trị đã đối chiếu với thông báo chính thức của trường (mặc định chưa).
// variant = chương trình/tổ hợp để phân biệt (VD "Chương trình tiên tiến"); chuỗi rỗng khi không có (để khoá duy nhất hoạt động).
model AdmissionScore {
  id         String   @id @default(cuid())
  school     String
  major      String
  variant    String   @default("")
  year       Int
  method     String
  score      Float
  scale      Int
  note       String?  @db.Text
  sourceUrl  String
  sourceName String
  verified   Boolean  @default(false)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([school, major, variant, year, method], name: "admission_score_key")
  @@index([published, year])
  @@map("admission_scores")
}

// ─── GIA SƯ DỜI / HUỶ MỘT BUỔI (hoàn thiện NV-189: dòng gợi ý loại 4) ──────────────────────────────────────────
// Định danh một buổi = (scheduleId, dateKey GỐC theo lịch tuần). Dời vẫn giữ định danh gốc để báo nghỉ và nhắc lịch của buổi đó
// không bị mồ côi; thời điểm hiệu lực lấy từ newDateKey / newStartTime / newEndTime (xem src/lib/sessionChange.ts).
//   cancel — buổi bị huỷ: không nhắc lịch, phụ huynh không báo nghỉ được nữa
//   move   — buổi dời sang newDateKey lúc newStartTime–newEndTime
// KHÔNG đụng tiền: học phí vẫn tính theo số buổi gia sư nhập (nối "không tính phí" vào phiếu là GD-25, chưa làm).
model ClassSessionChange {
  id           String    @id @default(cuid())
  courseId     String
  scheduleId   String // ClassSchedule.id — không FK: xoá khung giờ không được xoá lịch sử dời/huỷ
  dateKey      String // ngày GỐC theo lịch tuần, "YYYY-MM-DD" giờ VN
  kind         String // "cancel" | "move"
  newDateKey   String?
  newStartTime String? // "HH:mm"
  newEndTime   String? // "HH:mm"
  reason       String?   @db.Text
  changedBy    String // userId gia sư
  zaloOpenedAt DateTime? // gia sư ĐÃ MỞ Zalo để báo lớp — KiN không biết tin có đi thật hay không
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dateKey])
  @@index([courseId, dateKey])
  @@index([newDateKey])
  @@map("class_session_changes")
}

// ─── ĐĂNG NHẬP BẰNG MÃ 6 SỐ QUA EMAIL (TK-170, Figma "Đăng nhập" 21:9) ─────────────────────────────────────────
// Mỗi email có tối đa MỘT mã đang sống (email là khoá duy nhất): xin mã mới thì ghi đè mã cũ.
//   codeHash    — HMAC-SHA256(SESSION_SECRET, "email:mã"); KHÔNG lưu mã gốc; so bằng hàm so sánh thời gian hằng định.
//   attempts    — số lần nhập sai đã dùng. Trừ TRƯỚC khi so mã (nguyên tử) để gửi song song nhiều đoán mã cũng không vượt 5 lần;
//                 giữ qua các lần xin mã mới trong 15 phút để không lách bằng cách xin mã liên tục.
//   lockedUntil — đủ 5 lần sai thì khoá email này 15 phút (kể cả khi xin mã mới).
// Dùng xong (đúng mã) thì XOÁ dòng — mã một lần thì phải thật sự một lần. Xem src/lib/loginCode.ts.
model LoginCode {
  id          String    @id @default(cuid())
  email       String    @unique
  codeHash    String
  attempts    Int       @default(0)
  sentAt      DateTime  @default(now())
  expiresAt   DateTime
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("login_codes")
}

// ─── KiN PRO — NỀN GÓI (23/10/2026; docs/kin/rd/pro/tinh-nang-pro-tra-phi.md mục 8.4) ─────────────────────────
// "Đo trước, thu sau": chỉ THÊM bảng mới, không @unique trên bảng cũ. Không dùng Coin, không tự động trừ tiền.
// Cổng hạn mức TẮT mặc định (biến môi trường KIN_PLAN_ENFORCE); bảng cấu hình sửa từ admin, không viết cứng trong mã.

// Một dòng cho mỗi gói ("free" | "pro"). Thiếu dòng thì lấy mặc định ở src/lib/planLimits.ts (PLAN_DEFAULTS).
model PlanConfig {
  id                String   @id @default(cuid())
  code              String   @unique // "free" | "pro"
  name              String
  studentLimit      Int // trần học viên đang học (Pro: trần chống lạm dụng, không phải "vô hạn")
  aiExtractPerMonth Int // số lượt AI trích đề mỗi tháng (giờ VN)
  priceMonthVnd     Int // giá gói tháng (0 với Free)
  priceQuarterVnd   Int
  priceYearVnd      Int
  updatedBy         String? // userId admin sửa lần cuối
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@map("plan_configs")
}

// Cài đặt chung kiểu khoá-giá trị (số nguyên dạng chữ): ngày Pro tặng người dùng cũ, giảm giá sáng lập, số suất, số tháng khoá giá…
model SettingKV {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("setting_kv")
}

// Một yêu cầu mua / một kỳ Pro. Thu theo kỳ bằng QR chuyển khoản; admin đối chiếu sao kê rồi bấm kích hoạt (cộng dồn hạn).
// Giá được CHỤP lại lúc tạo yêu cầu (như priceCoinPaid): admin đổi giá sau không làm đổi yêu cầu đã tạo.
model ProOrder {
  id                  String    @id @default(cuid())
  userId              String // gia sư mua
  period              String // "month" | "quarter" | "year" | "grant" (tặng)
  durationDays        Int // snapshot thời hạn
  priceVnd            Int // snapshot số tiền phải chuyển (đã trừ giảm giá sáng lập); 0 với suất tặng
  listPriceVnd        Int // snapshot giá niêm yết lúc tạo
  foundingDiscountPct Int       @default(0) // snapshot % giảm giá sáng lập đã áp (0 = không)
  source              String    @default("purchase") // "purchase" | "legacy_grant" | "admin_grant"
  memoCode            String    @unique // nội dung chuyển khoản, vd "KINPRO-7K2Q9XMD"
  status              String    @default("pending") // "pending" | "active" | "cancelled"
  startDate           DateTime? // đặt lúc kích hoạt
  endDate             DateTime?
  activatedBy         String? // userId admin kích hoạt
  activatedAt         DateTime?
  bankRef             String? // mã giao dịch ngân hàng admin đối chiếu (tuỳ chọn)
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, endDate])
  @@index([status, createdAt])
  @@map("pro_orders")
}

// KiN Pro — khoản tiền SePay báo về tài khoản nhận tiền của KiN Pro (webhook riêng /api/webhooks/sepay-pro, KHÔNG phải webhook học phí của gia sư).
// Một giao dịch SePay = đúng một dòng ((provider, providerTxId) duy nhất): gọi lại cùng giao dịch không kích hoạt lần hai.
//   status "activated": đúng mã + đúng số tiền + yêu cầu đang chờ → đã kích hoạt (orderId có giá trị).
//   status "review":    mọi trường hợp còn lại (sai số tiền, mã lạ, yêu cầu đã huỷ / đã kích hoạt, không có mã…) → admin duyệt tay; KHÔNG tự hoàn tiền.
//   status "resolved":  admin đã xử lý xong ở ngoài (hoàn tiền thủ công hoặc kích hoạt tay) và bấm đánh dấu.
// Không FK: là sổ đối soát, không phải dữ liệu nghiệp vụ; không lưu số dư tài khoản (accumulated).
model ProPayment {
  id           String    @id @default(cuid())
  provider     String    @default("sepay")
  providerTxId String
  amount       Int
  content      String    @default("") @db.VarChar(500)
  occurredAt   DateTime
  matchedCode  String? // mã đơn Pro tìm thấy trong nội dung (nếu có)
  orderId      String? // yêu cầu Pro khớp mã (nếu có)
  status       String // "activated" | "review" | "resolved"
  reason       String? // với "review": no_code | unknown_code | amount_mismatch | order_not_pending | order_not_purchase
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([provider, providerTxId])
  @@index([status, createdAt])
  @@map("pro_payments")
}

// KiN Pro — nhắc gia hạn T-7/T-3/T-0: mỗi (gia sư, hạn của chu kỳ, mốc) đúng một dòng, nên một mốc gửi tối đa một lần cho mỗi chu kỳ.
// "Chu kỳ" = hạn Pro hiện tại của gia sư (cuối chuỗi các kỳ nối liền nhau); gia hạn xong hạn dời đi → chu kỳ mới, nhắc lại được.
// Dòng này chỉ được tạo CÙNG MỘT giao dịch với thông báo trong app, nên có dòng ⇔ thông báo thật sự đã được tạo.
model ProRenewalReminder {
  id        String   @id @default(cuid())
  userId    String
  cycleEnd  DateTime
  milestone Int // 7 | 3 | 0
  createdAt DateTime @default(now())

  @@unique([userId, cycleEnd, milestone])
  @@index([createdAt])
  @@map("pro_renewal_reminders")
}

// Nhật ký lượt dùng để ĐO (chế độ "đếm bóng") và để đếm hạn mức theo tháng. Không FK: là sổ đo, không phải dữ liệu nghiệp vụ.
//   kind: "ai_extract" (một lượt trích đề) | "gate_would_block" (cổng TẮT nhưng nếu bật sẽ chặn) | "gate_blocked" (cổng BẬT và đã chặn)
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String // gia sư (chủ gói)
  kind      String
  quantity  Int      @default(1)
  refType   String?
  refId     String?
  meta      Json? // không tên học sinh, không số tiền
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@index([kind, createdAt])
  @@map("usage_events")
}

// KiN Pro F6 — yêu cầu hỗ trợ của gia sư. Một hàng đợi chung; gói Pro được xếp trước (chụp lại gói LÚC GỬI), hứa "trong giờ hành chính", không hứa 24/7.
// Lỗi nghiêm trọng và vấn đề riêng tư (kind = "serious") KHÔNG phân tầng: Free và Pro cùng vào làn khẩn, không phải đặc quyền Pro.
// Không có trường học sinh/phụ huynh: nội dung là chữ gia sư tự viết, form dặn không ghi tên/số điện thoại/ảnh của học sinh.
model SupportRequest {
  id          String    @id @default(cuid())
  userId      String // gia sư gửi
  kind        String // "setup" | "payment" | "other" | "serious"
  subject     String    @db.VarChar(120)
  message     String    @db.Text
  planAtSend  String // "free" | "pro" (chụp lúc gửi)
  status      String    @default("open") // "open" | "answered" | "closed"
  reply       String?   @db.Text // câu trả lời của quản trị, gia sư xem được
  repliedBy   String? // userId quản trị
  repliedAt   DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("support_requests")
}

// ─── HỒ SƠ HỌC SINH CỦA GIA SƯ + ĐỒNG Ý DỮ LIỆU TRẺ (23/10/2026) ───────────────
// Chủ dự án quyết 23/10: "Làm đầy đủ, có hộp đồng ý" cho dữ liệu trẻ dưới 16. CHƯA có ý kiến luật sư (Nghị định 13/2023,
// Luật Trẻ em 2016, Luật 91/2025) — cần có trước khi mở cho người dùng thật. Quy tắc ở src/lib/consentPolicy.ts.
// Mọi bảng dưới đây là bảng MỚI (chỉ thêm), không đổi bảng cũ ngoài hai cột/quan hệ nói ở trên.

// Hồ sơ RIÊNG của một gia sư về một em: không có tài khoản (userId null) hoặc là ghi chú riêng của gia sư về em đã có tài khoản
// (userId có giá trị — KHÔNG đụng dữ liệu tài khoản của em, gia sư khác không thấy). Chỉ chủ hồ sơ (tutorId) đọc/sửa được.
// Chỉ lưu được khi đã có đồng ý đủ bên (ConsentRecord); thu hồi → các trường ngoài tên bị che (xem maskProfile).
model StudentProfile {
  id            String    @id @default(cuid())
  tutorId       String
  userId        String? // em đã có tài khoản và đang học lớp của chính gia sư này; null = hồ sơ không tài khoản
  courseId      String? // lớp của gia sư (kiểm ở máy chủ); với status waitlist là lớp em đang chờ
  name          String
  // Nhóm tuổi gia sư khai khi chưa có ngày sinh: "u7" (dưới 7) | "7to15" | "16plus". Có ngày sinh thì ngày sinh quyết định.
  ageGroup      String
  status        String    @default("active") // "active" | "inactive" | "waitlist"
  familyId      String?
  guardianName  String?
  guardianPhone String?
  // ── Nhóm "mở rộng" (cần phạm vi đồng ý "extended")
  birthDate     String? // "YYYY-MM-DD"
  address       String?
  phone         String?
  phoneExtra    String?
  email         String?
  emailExtra    String?
  startDate     String? // ngày bắt đầu học "YYYY-MM-DD"
  subjects      String[]  @default([])
  notes         String?   @db.Text
  customData    Json? // { [StudentFieldDef.id]: "chữ" }
  source        String    @default("manual") // "manual" | "wizard" | "paste" | "csv" | "request"
  batchId       String? // lần nhập hàng loạt (ConsentRecord.batchId cùng giá trị)
  requestId     String? // từ yêu cầu tìm gia sư (TutorRequest)
  waitlistedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tutor  User         @relation("StudentProfileTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  user   User?        @relation("StudentProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  course Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  family FamilyGroup? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([tutorId, status])
  @@index([userId])
  @@index([courseId])
  @@index([familyId])
  @@map("student_profiles")
}

// Sổ ghi vết đồng ý. Mỗi dòng = một bên (party) đồng ý một nhóm phạm vi (scopes) bằng một phương thức, kèm phiên bản chữ đã hiện.
// Thu hồi = đặt revokedAt (không xoá dòng — giữ vết). Đồng ý lại = dòng MỚI. Không chứa tên/số liên lạc của trẻ, chỉ id.
// "tutor_attestation" nghĩa là GIA SƯ tự xác nhận đã có đồng ý của phụ huynh/em; KiN KHÔNG kiểm tra giấy tờ nên không phải "đã xác minh".
model ConsentRecord {
  id          String    @id @default(cuid())
  subjectType String // "student_profile" | "tutor_request"
  subjectId   String
  party       String // "guardian" | "child" | "self"
  scopes      String[] // "basic" | "extended" | "scores" | "family"
  method      String // "tutor_attestation" | "guest_form"
  textVersion String
  givenById   String? // người bấm (gia sư); khách không đăng nhập = null
  givenByRole String // "tutor" | "guest"
  batchId     String?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?
  revokeCause String? // "guardian_request" | "child_request" | "tutor_decision" | "profile_deleted"

  @@index([subjectType, subjectId])
  @@index([batchId])
  @@map("consent_records")
}

// Trường tuỳ chỉnh của gia sư (LO-18). Số trường tối đa cấu hình bằng KIN_CUSTOM_FIELDS_MAX (xem studentProfile.ts).
model StudentFieldDef {
  id        String   @id @default(cuid())
  tutorId   String
  label     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  tutor User @relation("StudentFieldDefTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("student_field_defs")
}

// Hồ sơ gia đình dùng chung liên hệ (HS-12). CHỈ chung liên hệ — KHÔNG gộp phiếu học phí theo gia đình.
model FamilyGroup {
  id            String   @id @default(cuid())
  tutorId       String
  label         String
  guardianName  String?
  guardianPhone String?
  createdAt     DateTime @default(now())

  tutor    User             @relation("FamilyGroupTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  profiles StudentProfile[]

  @@index([tutorId])
  @@map("family_groups")
}

// Điểm 0-10 và % hoàn thành BTVN của một em trong một buổi (BU-11). Chỉ gia sư của lớp và phụ huynh của đúng em đó (qua link Sổ của con) thấy.
// Chỉ ghi được khi hồ sơ của em có đồng ý phạm vi "scores". Bảng riêng để KHÔNG đụng AttendanceRecord (điểm danh/học phí).
model SessionStudentScore {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  tutorId     String
  score       Float? // 0..10, bước 0,25
  homeworkPct Int? // 0..100
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User              @relation("SessionScoreStudent", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("session_student_scores")
}

// Yêu cầu tìm gia sư của khách (KH-04 / PH-07). Chỉ thu tối thiểu: cấp học, môn, khu vực, khung giờ, tên + số Zalo của PHỤ HUYNH.
// KHÔNG thu tên hay ngày sinh của trẻ. Gửi kèm đồng ý của phụ huynh (ConsentRecord, method "guest_form"). Theo dõi bằng mã trackToken.
model TutorRequest {
  id            String    @id @default(cuid())
  trackToken    String    @unique
  targetTutorId String? // gửi tới đúng một gia sư (từ /mentor/<id>); null = yêu cầu chung (chưa có ai nhận)
  level         String // "tieu-hoc" | "thcs" | "thpt" | "khac"
  subject       String
  city          String?
  district      String?
  mode          String? // "online" | "offline" | "both"
  slots         String? // khung giờ muốn học (chữ tự do ngắn)
  note          String?
  contactName   String? // tên PHỤ HUYNH
  contactPhone  String // SĐT Zalo PHỤ HUYNH, 10 số
  phoneKey      String // băm một chiều của SĐT để chống spam (không dùng để hiện)
  status        String    @default("new") // "new" | "accepted" | "declined" | "closed"
  decidedAt     DateTime?
  profileId     String? // hồ sơ gia sư tạo khi tiếp nhận
  createdAt     DateTime  @default(now())

  target User? @relation("TutorRequestTarget", fields: [targetTutorId], references: [id], onDelete: SetNull)

  @@index([targetTutorId, status])
  @@index([phoneKey, createdAt])
  @@map("tutor_requests")
}

// ─── QZ-08: CHẤM QUIZ HỖN HỢP — CHỜ CHẤM VÀ CÔNG BỐ ──────────────────────────────────────────────
// Ba bảng MỚI, chỉ thêm. Cố ý KHÔNG khai báo quan hệ Prisma tới Exam/ExamAttempt (tránh sửa model Exam*, mỗi nơi chỉ giữ id dạng chuỗi);
// khi lượt thi bị xoá thì dòng ở đây thành mồ côi, vô hại: mọi truy vấn đều đi từ ExamAttempt / Exam trước.
//   ExamPublishPolicy  — đề nào "giữ điểm đến khi gia sư công bố". KHÔNG có dòng = hành vi cũ (học sinh thấy điểm ngay), nên đề cũ không đổi.
//   ExamAttemptPublish — lượt thi đã được công bố (có dòng = học sinh được thấy điểm tổng, điểm và nhận xét tự luận, đáp án theo cấu hình đề).
//   ExamGradeEdit      — lịch sử mỗi lần gia sư lưu điểm/nhận xét một câu tự luận (điểm cũ → điểm mới); chỉ thêm, không sửa, không xoá.
model ExamPublishPolicy {
  examId           String   @id
  holdUntilPublish Boolean  @default(true)
  updatedById      String?
  updatedAt        DateTime @updatedAt

  @@map("exam_publish_policies")
}

model ExamAttemptPublish {
  attemptId     String   @id
  examId        String
  publishedById String
  publishedAt   DateTime @default(now())

  @@index([examId])
  @@map("exam_attempt_publishes")
}

// QZ — hạn nộp RIÊNG cho từng học sinh của một quiz/đề (bảng MỚI, không đụng Exam). Không có dòng = học sinh theo lịch chung của đề (date/time/duration, cột active).
// Có dòng = học sinh KHÔNG được bắt đầu lượt mới sau `dueAt` (lượt đang làm dở vẫn tới hết giờ làm bài của lượt đó). Gia sư chủ đề đặt/xoá; mỗi lần đặt ghi ExamChangeLog.
// Không có khoá ngoại để xoá đề / xoá học sinh không bị chặn (dòng mồ côi vô hại). Một học sinh một dòng cho mỗi đề.
model QuizStudentDeadline {
  id        String   @id @default(cuid())
  examId    String
  userId    String
  dueAt     DateTime
  note      String?  @db.Text
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, userId])
  @@index([userId])
  @@map("quiz_student_deadlines")
}

model ExamGradeEdit {
  id          String   @id @default(cuid())
  examId      String
  attemptId   String
  questionId  String
  editedById  String
  prevPoints  Float?
  newPoints   Float
  prevComment String?  @db.Text
  newComment  String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([attemptId, questionId])
  @@index([examId, createdAt])
  @@map("exam_grade_edits")
}

// ─── TIẾNG ANH TỰ HỌC (IELTS 3.0 → 6.5) ─────────────────────────────────────
// Đặc tả: docs/tieng-anh/DAC-TA.md. Toàn bộ là bảng MỚI, chỉ thêm (db push an toàn).
// Quy tắc riêng tư: mọi thứ có ownerId/userId chỉ chủ sở hữu thấy. Sách người học tải lên (có bản quyền)
// KHÔNG BAO GIỜ công khai — chỉ lưu chữ đã trích, không lưu file PDF.

model EngProfile {
  userId         String   @id
  targetBand     Float    @default(6.5)
  examDate       String? // "YYYY-MM-DD"
  dailyNew       Int      @default(15) // số từ mới mỗi ngày
  dailyReviewCap Int      @default(150) // quá ngưỡng này thì tạm dừng từ mới
  dailyMinutes   Int      @default(120)
  placementDone  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("eng_profiles")
}

// Kho từ chung: NGSL 1.01 + từ bổ sung + NAWL (CC BY-SA 4.0, Browne, Culligan & Phillips) và từ người học tự bắt.
model EngWord {
  id           String   @id @default(cuid())
  lemma        String   @unique
  list         String // "ngsl" | "sup" | "nawl" | "own"
  listRank     Int? // thứ hạng trong danh sách của nó
  freqRank     Int? // thứ hạng tần suất chung (1 = phổ biến nhất)
  pos          String?
  ipa          String?
  meaningVi    String?
  definitionEn String?
  example      String?
  createdAt    DateTime @default(now())

  userWords EngUserWord[]
  cards     EngCard[]

  @@index([list, listRank])
  @@map("eng_words")
}

model EngUserWord {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  status    String   @default("learning") // "known" | "learning" | "ignored"
  source    String // "placement" | "reader" | "list" | "book" | "finish"
  context   String? // câu gốc lúc bắt từ
  contextVi String? // nghĩa tiếng Việt theo đúng câu đó
  textId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  word EngWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, status])
  @@map("eng_user_words")
}

// Thẻ ôn FSRS (ts-fsrs). key: "w:<wordId>:<cardType>" hoặc "x:<exerciseId>" — chống trùng ở tầng DB.
model EngCard {
  id            String    @id @default(cuid())
  userId        String
  key           String
  kind          String // "word" | "exercise"
  cardType      String // word: "recognize" | "listen" | "cloze" | "recall"; exercise: "redo"
  wordId        String?
  exerciseId    String?
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0) // 0 New, 1 Learning, 2 Review, 3 Relearning
  lastReview    DateTime?
  suspended     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word     EngWord?       @relation(fields: [wordId], references: [id], onDelete: Cascade)
  exercise EngExercise?   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  logs     EngReviewLog[]

  @@unique([userId, key])
  @@index([userId, due])
  @@map("eng_cards")
}

model EngReviewLog {
  id            String   @id @default(cuid())
  cardId        String
  userId        String
  rating        Int // 1 Again, 2 Hard, 3 Good, 4 Easy
  state         Int
  elapsedDays   Int
  scheduledDays Int
  durationMs    Int?
  reviewedAt    DateTime @default(now())

  card EngCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@map("eng_review_logs")
}

// Bài đọc / nghe. ownerId = null: bài công khai (VOA Learning English — public domain).
// ownerId có giá trị: bài người học tự dán hoặc trích từ sách — chỉ người đó thấy.
model EngText {
  id          String    @id @default(cuid())
  ownerId     String?
  source      String // "voa" | "paste" | "book"
  sourceUrl   String?
  title       String
  body        String    @db.Text
  audioUrl    String?
  topic       String?
  wordCount   Int
  license     String // "public-domain" | "private"
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  exercises EngExercise[]

  @@unique([source, sourceUrl])
  @@index([ownerId, createdAt])
  @@map("eng_texts")
}

model EngBook {
  id         String   @id @default(cuid())
  ownerId    String
  title      String
  kind       String // "grammar" | "skills" | "other"
  fileName   String
  pageCount  Int      @default(0)
  status     String   @default("pages") // "pages" (đang nạp trang) | "splitting" | "processing" | "ready" | "error"
  statusNote String?
  unitsTotal Int      @default(0)
  unitsDone  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner  User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pages  EngBookPage[]
  units  EngUnit[]
  chunks EngChunk[]

  @@index([ownerId])
  @@map("eng_books")
}

model EngBookPage {
  id     String @id @default(cuid())
  bookId String
  pageNo Int // 1-based như số trang PDF
  text   String @db.Text

  book EngBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, pageNo])
  @@map("eng_book_pages")
}

model EngUnit {
  id               String   @id @default(cuid())
  bookId           String
  ownerId          String
  order            Int
  unitNo           String?
  title            String
  group            String?
  pageStart        Int
  pageEnd          Int
  summaryVi        String?  @db.Text
  keyPoints        Json? // string[]
  examples         Json? // string[] — câu ví dụ trích nguyên văn từ sách
  mistakesVi       Json? // string[] — lỗi người Việt hay gặp
  status           String   @default("raw") // "raw" | "ready" | "error"
  statusNote       String?
  createdAt        DateTime @default(now())

  book      EngBook           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  exercises EngExercise[]
  progress  EngUnitProgress[]
  chunks    EngChunk[]

  @@unique([bookId, order])
  @@index([ownerId])
  @@map("eng_units")
}

// Đoạn văn của sách cho "Hỏi sách" (RAG). embedding: gemini-embedding-001, 768 chiều — đọc/ghi qua $queryRaw như question_bank_items.
model EngChunk {
  id        String                      @id @default(cuid())
  bookId    String
  unitId    String?
  ownerId   String
  pageNo    Int
  text      String                      @db.Text
  embedding Unsupported("vector(768)")?

  book EngBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  unit EngUnit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([ownerId, bookId])
  @@map("eng_chunks")
}

model EngExercise {
  id          String   @id @default(cuid())
  ownerId     String? // null = câu hỏi của bài công khai
  unitId      String?
  textId      String?
  type        String // "gap" | "choice" | "transform" | "tfng" | "error" | "order"
  instruction String?
  prompt      String   @db.Text
  options     String[] @default([])
  answers     String[] // mọi đáp án được chấp nhận
  explanation String?  @db.Text
  origin      String // "book" | "ai"
  verified    Boolean  @default(false) // AI tự giải lại ra đúng đáp án
  flagged     Boolean  @default(false) // người học báo sai → không dùng nữa
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  unit     EngUnit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  text     EngText?     @relation(fields: [textId], references: [id], onDelete: Cascade)
  attempts EngAttempt[]
  cards    EngCard[]

  @@index([unitId, origin])
  @@index([textId])
  @@map("eng_exercises")
}

model EngAttempt {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  answer     String
  correct    Boolean
  createdAt  DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise EngExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([exerciseId])
  @@map("eng_attempts")
}

model EngUnitProgress {
  id            String   @id @default(cuid())
  userId        String
  unitId        String
  status        String   @default("learning") // "learning" | "done" | "review"
  bestScore     Int      @default(0) // % đúng tốt nhất
  lastScore     Int?
  attempts      Int      @default(0)
  lastStudiedAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit EngUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@map("eng_unit_progress")
}

model EngWriting {
  id           String   @id @default(cuid())
  userId       String
  taskType     String // "task1" | "task2" | "paragraph"
  prompt       String   @db.Text
  body         String   @db.Text
  wordCount    Int
  feedback     Json?
  bandLow      Float?
  bandHigh     Float?
  revisionOfId String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("eng_writings")
}

// Nhật ký học theo NGÀY GIỜ VIỆT NAM — nguồn của chuỗi ngày học và thống kê. Một dòng / người / ngày / module.
model EngStudyLog {
  id      String @id @default(cuid())
  userId  String
  day     String // "YYYY-MM-DD" theo giờ Việt Nam
  module  String // "tu-vung" | "doc" | "nghe" | "lop-hoc" | "viet"
  items   Int    @default(0)
  correct Int    @default(0)
  total   Int    @default(0)
  seconds Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, module])
  @@map("eng_study_logs")
}

// Bộ nhớ đệm tra nghĩa theo ngữ cảnh (khoá = băm của từ + câu) — một câu chỉ hỏi AI một lần.
model EngLookup {
  key       String   @id
  lemma     String
  meaningVi String
  note      String?
  createdAt DateTime @default(now())

  @@map("eng_lookups")
}

// Thi thử IELTS. Listening/Reading: phiếu 40 câu chấm theo đáp án người học dán từ sách (Cambridge IELTS…) → điểm thô → band
// (bảng xấp xỉ trong lib/english/mock.ts). Writing/Speaking: band do người học tự nhập (giáo viên/người 7.0+ chấm).
model EngMock {
  id        String   @id @default(cuid())
  userId    String
  skill     String // "listening" | "reading" | "writing" | "speaking"
  module    String   @default("academic") // Reading: "academic" | "general"
  title     String // vd "Cambridge 18 — Test 2"
  raw       Int? // số câu đúng / 40 (L/R)
  band      Float
  answers   String[] @default([])
  answerKey String[] @default([])
  seconds   Int      @default(0)
  note      String?
  takenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skill, takenAt])
  @@map("eng_mocks")
}
