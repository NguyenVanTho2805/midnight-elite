  ownedCourses        Course[]
  ownedExams          Exam[]
  questionBankItems   QuestionBankItem[]
  examGuestAccess     ExamGuestAccess[]
  examFiles           ExamFile[]
  examFileFolders     ExamFileFolder[]
  ownedAssignments      Assignment[]           @relation("OwnedAssignments")
  assignmentSubmissions AssignmentSubmission[] @relation("AssignmentSubmissions")
  assignmentAnswers     AssignmentAnswer[]     @relation("AssignmentAnswers")
  enrollments         Enrollment[]
  verifyTokens        VerifyToken[]
