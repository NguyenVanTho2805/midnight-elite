+async function toCoverDataUrl(file: File): Promise<string | null> {
+  const bmp = await createImageBitmap(file);
+  const W = 960, H = 540;
+  const c = document.createElement("canvas"); c.width = W; c.height = H;
+  const s = Math.max(W / bmp.width, H / bmp.height);
