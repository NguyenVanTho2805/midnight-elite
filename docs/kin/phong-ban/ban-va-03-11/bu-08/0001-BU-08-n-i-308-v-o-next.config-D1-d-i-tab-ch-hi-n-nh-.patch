 import type { NextConfig } from "next";
+import { nextAdminRedirects } from "./src/lib/adminRedirects";
 
 const nextConfig: NextConfig = {
   // @napi-rs/canvas ships a native binary loader (js-binding.js) that
@@ -14,6 +15,12 @@ const nextConfig: NextConfig = {
   // cả hai tên miền thật (chuyển tên miền giữ nguyên cổng) và cần trang hydrate được ở cả hai.
   allowedDevOrigins: ["admin.midnightelite-edu.com", "midnightelite-edu.com"],
 
+  // BU-08 (mục 4.6 / D1): đường quản trị cũ → mới bằng 308. Đích không phụ thuộc người xem nên an toàn để trình duyệt nhớ (khác các chuyển hướng theo phiên
+  // ở hostRouting.ts). Một nguồn: src/lib/adminRedirects.ts (phần thuần, có test t-admin-redirects-lib / t-admin-redirects).
+  async redirects() {
+    return nextAdminRedirects();
+  },
+
   // ĐX-02: service worker (public/sw.js) không bao giờ được nằm trong bộ nhớ đệm — trình duyệt phải luôn lấy bản mới nhất để cập nhật được.
   // CSP chặt: tệp này chỉ được chạy mã cùng nguồn. Cấu hình theo hướng dẫn PWA của Next 16 (node_modules/next/dist/docs/01-app/02-guides/progressive-web-apps.md).
   async headers() {
diff --git a/src/components/admin/AdminShell.tsx b/src/components/admin/AdminShell.tsx
index 6b33d14..671ecda 100644
--- a/src/components/admin/AdminShell.tsx
+++ b/src/components/admin/AdminShell.tsx
@@ -53,7 +53,10 @@ export default function AdminShell({ children }: { children: ReactNode }) {
   const hit = matchSub(pathname);
   const modules = visibleModules(user?.adminRole);
   const current = modules.find(m => m.key === hit?.moduleKey) ?? null;
-  const tabs = current && current.subs.length > 1 ? current.subs : null;
+  // BU-08 (D3a): dải tab chỉ hiện NHÓM đang ở (≤ 6 tab) theo `group` của adminNav; trang không thuộc nhóm nào thì giữ cả module như trước.
+  const group = hit?.sub.group;
+  const groupSubs = current ? (group ? current.subs.filter(s => s.group === group) : current.subs) : [];
+  const tabs = groupSubs.length > 1 ? groupSubs : null;
   // Chiều cao dải trên + dải tab: các khung Outlook trong trang trừ đi để vừa khít màn hình, không sinh thanh cuộn của trang.
   const top = STRIP + (tabs ? TABS : 0);
   const flush = pathname === "/admin/kiem-duyet";
@@ -77,7 +80,7 @@ export default function AdminShell({ children }: { children: ReactNode }) {
