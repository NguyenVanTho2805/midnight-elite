# Mẫu biến môi trường (chỉ phần đăng nhập Google; các biến khác xem tools/local-e2e/env.example.sh và README).
# "Tiếp tục với Google" cho học sinh: CẢ HAI biến đều có thì nút mới hiện; thiếu một thì nút ẩn, không lỗi.
# Tạo OAuth client (Web application) ở Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: <TÊN MIỀN CHÍNH>/api/auth/google/callback   (vd https://midnightelite-edu.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tuỳ chọn: ép redirect URI nếu máy chủ không suy đúng tên miền từ x-forwarded-host.
# GOOGLE_REDIRECT_URI=

# "Tiếp tục với Facebook" cho học sinh: CẢ HAI biến đều có thì nút mới hiện; thiếu một thì ẩn, không lỗi.
# Tạo app ở developers.facebook.com (loại Consumer) → thêm sản phẩm "Facebook Login"; bật quyền `email`; chuyển app sang chế độ Live.
# Valid OAuth Redirect URI: <TÊN MIỀN CHÍNH>/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Tuỳ chọn: ép redirect URI nếu máy chủ không suy đúng tên miền.
# FACEBOOK_REDIRECT_URI=
