# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# scratchpad — session-local test harness (chạy ./npx tsx scratchpad/*.ts)
# không commit vào repo, mỗi session Claude tự dựng.
/scratchpad

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel

# design references (large, not source code)
__awesome-design/
reports/

# TSIX Sales Bot — project Python riêng, KHÔNG liên quan Vercel/Next.js,
# có .env chứa secrets thật (Gemini API key, DB connection string)
tsix-sales-bot/
.playwright-mcp/


# dev-server logs, ad-hoc screenshot scripts/output, cookie dumps từ curl
# testing — không nên track (từng bị commit nhầm, xem session cleanup)
__dev.log
__screenshots/
__screenshots.mjs
cookies*.txt
*.png
# ngoại lệ: biểu tượng ứng dụng PWA (ĐX-02) phải được commit — manifest và thông báo đẩy tham chiếu tới chúng
!/public/icons/*.png
# ngoại lệ: ảnh chia sẻ og:image của hồ sơ gia sư (/mentor/[id]) — trước đây bị "*.png" chặn nên KHÔNG BAO GIỜ được commit, link chia sẻ trên Facebook / Zalo không có ảnh
!/public/og-kin.png

# bản sao bộ test cục bộ: mật khẩu DB thử và ảnh chụp không commit
/tools/local-e2e/env.sh
/tools/local-e2e/shots/

# Rác phát triển (từng bị commit nhầm)
/__dev.log
/__screenshots/
